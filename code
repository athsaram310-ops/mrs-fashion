/* Post an Ad */
.ad-request-btn {
    position: fixed; left: 24px; bottom: 156px; z-index: 500;
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,0.38); border-radius: 50%;
    background: linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.08));
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    color: var(--accent-color, #f43f5e); font-size: 22px; cursor: pointer;
    box-shadow: 0 12px 30px rgba(15,23,42,0.22), inset 0 1px 0 rgba(255,255,255,0.42);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}

.ad-request-btn:hover,
.ad-request-btn:focus-visible {
    transform: translateY(-3px) scale(1.05); border-color: rgba(255,255,255,0.6); outline: none;
}

.ad-request-btn::after {
    content: 'Post an Ad'; position: absolute; left: calc(100% + 14px); top: 50%;
    transform: translateY(-50%) translateX(-6px);
    background: rgba(15,23,42,0.92); color: #fff; padding: 7px 14px; border-radius: 8px;
    font: 600 12.5px 'Segoe UI', Tahoma, sans-serif; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity .2s ease, transform .2s ease;
}

.ad-request-btn:hover::after,
.ad-request-btn:focus-visible::after {
    opacity: 1; transform: translateY(-50%) translateX(0);
}

.ad-request-btn {
    overflow: hidden;
}

.ad-request-btn img {
    width: 76%;
    height: 76%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.ad-request-modal {
    position: fixed; inset: 0; z-index: 40550; padding: 20px;
    background: rgba(15,23,42,0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    display: none; align-items: center; justify-content: center;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.ad-request-modal.active { display: flex; animation: fadeIn .35s ease-out; }

.ad-request-content {
    position: relative; width: min(640px, 96vw); max-height: 92vh; overflow-y: auto;
    background: #fff; border-radius: 24px; padding: 40px 42px 36px;
    box-shadow: 0 40px 100px rgba(15,23,42,0.42); animation: slideUp .45s ease-out;
}

.ad-request-close {
    position: absolute; top: 16px; right: 16px; background: none; border: none;
    font-size: 26px; line-height: 1; color: #64748b; cursor: pointer; transition: transform .3s ease, color .2s ease;
}

.ad-request-close:hover { transform: rotate(90deg); color: var(--accent-color, #f43f5e); }

.ad-request-header { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }

.ad-request-header i {
    width: 42px; height: 42px; flex-shrink: 0; border-radius: 50%; background: #fdeef1;
    color: var(--accent-color, #f43f5e); display: flex; align-items: center; justify-content: center; font-size: 17px;
}

.ad-request-header h2 { font-size: 22px; font-weight: 800; color: var(--text-dark, #1e293b); margin: 0; }

.ad-request-sub { font-size: 13px; line-height: 1.55; color: var(--text-light, #64748b); margin-bottom: 24px; }

.ad-request-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }

.ad-request-field { margin-bottom: 18px; }

.ad-request-field.full { grid-column: 1 / -1; }

.ad-request-field label {
    display: block; font-size: 12.5px; font-weight: 700; letter-spacing: .03em;
    color: var(--text-dark, #1e293b); margin-bottom: 8px;
}

.ad-request-field input,
.ad-request-field select {
    width: 100%; padding: 12px 14px; border: 1.5px solid #e2e2e2; border-radius: 8px;
    font-size: 14px; font-family: inherit; color: var(--text-dark, #1e293b); background: #fff;
    transition: border-color .2s ease, box-shadow .2s ease;
}

.ad-request-field input:focus,
.ad-request-field select:focus {
    outline: none; border-color: var(--primary-color, #1a1a1a); box-shadow: 0 0 0 3px rgba(26,26,26,0.07);
}

.ad-request-field .has-error { border-color: var(--accent-color, #f43f5e); }

.ad-request-error { display: none; margin-top: 6px; font-size: 12px; font-weight: 600; color: var(--accent-color, #f43f5e); }

.ad-request-field.invalid .ad-request-error { display: block; }

.ad-request-submit {
    width: 100%; padding: 14px; border: none; border-radius: 10px;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff; font-size: 15px; font-weight: 700; cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease;
}

.ad-request-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(26,26,26,0.3); }

.ad-request-done { display: none; text-align: center; padding: 30px 6px 10px; }

.ad-request-done.show { display: block; animation: fadeIn .4s ease; }

.ad-request-done-icon {
    width: 72px; height: 72px; margin: 0 auto 20px; border-radius: 50%; background: #fdeef1;
    color: var(--accent-color, #f43f5e); display: flex; align-items: center; justify-content: center; font-size: 30px;
}

.ad-request-done p { font-size: 18px; font-weight: 700; line-height: 1.5; color: var(--text-dark, #1e293b); max-width: 360px; margin: 0 auto 26px; }

.ad-request-done button {
    padding: 12px 34px; border: 2px solid var(--primary-color, #1a1a1a); border-radius: 50px;
    background: transparent; color: var(--primary-color, #1a1a1a); font-size: 14px; font-weight: 700; cursor: pointer;
    transition: background .25s ease, color .25s ease;
}

.ad-request-done button:hover { background: var(--primary-color, #1a1a1a); color: #fff; }

@media (max-width: 560px) {
.ad-request-btn { left: 16px; bottom: 138px; width: 48px; height: 48px; font-size: 19px; }
.ad-request-content { padding: 30px 22px 26px; border-radius: 20px; }
.ad-request-grid { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
.ad-request-modal.active,
.ad-request-content,
.ad-request-done.show { animation: none; }
}

