        function renderLoan() {
            const loan = currentLoan();
            if (!loan) return;
            const rows = buildSchedule(loan);
            const p = loan.paidCount;
            const remaining = loan.months - p;
            const done = remaining <= 0;
            const nextRow = done ? null : rows[p];

            $('scrLoanRef').textContent = '#' + loan.reference;
            $('scrLoanWho').textContent = `${loan.borrowerName} · ${lkr(loan.amount)} over ${loan.months} months at ${loan.monthlyRatePct}% per month`;

            $('scrStatBalance').textContent = lkr(remaining * loan.monthly);
            $('scrStatBalanceNote').textContent = done ? 'Fully repaid' : `${remaining} × ${lkr(loan.monthly)} still to pay`;
            $('scrStatNext').textContent = done ? '—' : lkr(loan.monthly);
            $('scrStatNextNote').textContent = done ? 'No payment due'
                : (nextRow.status === 'overdue' ? `Overdue since ${fmtDate(nextRow.due)}`
                    : nextRow.status === 'today' ? 'Due today' : `Due ${fmtDate(nextRow.due)}`);
