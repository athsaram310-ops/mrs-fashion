@media (max-width: 1200px) {
.checkout-body { grid-template-columns: minmax(0, 1fr) clamp(280px, 30vw, 380px); }
.checkout-form-col { padding-left: clamp(20px, 3vw, 40px); padding-right: clamp(20px, 3vw, 40px); }
