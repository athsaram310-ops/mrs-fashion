* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary-color: #1a1a1a;
    --secondary-color: #333333;
    --accent-color: #f43f5e;
    --dark-bg: #0f172a;
    --light-bg: #f8fafc;
    --text-dark: #1e293b;
    --text-light: #64748b;
    --white: #ffffff;
    --gradient: linear-gradient(135deg, #1a1a1a, #333333);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text-dark);
    background-color: var(--white);
    overflow-x: hidden;
}

/* Spin to Win */
.spin-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

.spin-modal-overlay.open { display: flex; }

.spin-modal {
    background: #fff;
    border-radius: 20px;
    width: min(780px, 96vw);
    display: flex;
    overflow: hidden;
    position: relative;
    max-height: 92vh;
}

.spin-modal-left {
    background: #fdf2f4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    flex-shrink: 0;
}

.spin-modal-right {
    padding: 44px 36px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
}

.spin-modal-close {
    position: absolute;
    top: 16px;
    right: 18px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #888;
    line-height: 1;
    z-index: 2;
}

.spin-modal-close:hover { color: #333; }

.spin-modal-title {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    margin: 0;
}

.spin-modal-subtitle {
    font-size: 14px;
    color: #555;
    line-height: 1.5;
    margin: 0;
}

.spin-modal-input {
    width: 100%;
    padding: 13px 16px;
    border: 1.5px solid #ddd;
    border-radius: 10px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
    font-family: inherit;
}

.spin-modal-input:focus { border-color: #e11d4a; }

.spin-modal-btn {
    width: 100%;
    padding: 14px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
}

.spin-modal-btn:hover { background: #333; transform: translateY(-2px); }

.spin-modal-skip {
    text-align: center;
    font-size: 13px;
    color: #e11d4a;
    cursor: pointer;
    font-weight: 600;
    text-decoration: underline;
}

.spin-modal-note {
    font-size: 11px;
    color: #999;
    text-align: center;
    line-height: 1.5;
    margin: 0;
}

.spin-modal-result { display: none; text-align: center; animation: fadeIn 0.5s ease; }

.spin-modal-result.show { display: block; }

.spin-modal-result h3 { font-size: 22px; color: #1a1a1a; margin-bottom: 8px; }

.spin-modal-result .spin-won-label { font-size: 16px; color: #555; margin-bottom: 6px; }

.spin-code {
    font-size: 28px;
    font-weight: 900;
    color: #e11d4a;
    letter-spacing: 0.1em;
    border: 2.5px dashed #e11d4a;
    padding: 10px 24px;
    border-radius: 10px;
    display: inline-block;
    margin: 10px 0;
}

.spin-modal-result p { color: #555; font-size: 13px; }

.wheel-wrap { position: relative; width: 240px; height: 240px; }

.wheel-wrap canvas { border-radius: 50%; display: block; }

.wheel-pointer {
    position: absolute;
    right: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    border-right: 22px solid #555;
}

.wheel-center-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #ccc;
    cursor: pointer;
    font-size: 10px;
    font-weight: 700;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
}

@media (max-width: 600px) {
.spin-modal { flex-direction: column; }
.spin-modal-left { padding: 24px 16px; }
.wheel-wrap { width: 180px; height: 180px; }
.spin-modal-right { padding: 24px 20px; }
}

/* Cart Modal */
.cart-modal {
    position: fixed;
    top: 70px;
    right: -400px;
    width: 400px;
    height: 650px;
    background: var(--white);
    box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);
    z-index: 200;
    transition: right 0.4s ease;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.cart-modal.active {
    right: 0;
}

.cart-header {
    padding: 20px;
    border-bottom: 2px solid var(--primary-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--primary-color);
    color: var(--white);
}

.cart-header h2 {
    font-size: 20px;
}

.cart-close {
    background: none;
    border: none;
    color: var(--white);
    font-size: 24px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.cart-close:hover {
    transform: rotate(90deg);
}

.cart-items {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-bottom: 15px;
    animation: slideInLeft 0.3s ease-out;
}

.cart-item-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
}

.cart-item-name {
    flex: 1;
    font-weight: 600;
    color: var(--text-dark);
}

.cart-item-color {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-light);
}

.cart-item-color-swatch {
    width: 13px;
    height: 13px;
    border-radius: 4px;
    border: 1.5px solid rgba(26, 26, 26, 0.15);
    display: inline-block;
    flex-shrink: 0;
}

.cart-item-qty-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
}

.cart-qty-btn {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 1.5px solid #e0e0e0;
    background: var(--white);
    color: var(--text-dark);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.cart-qty-btn:hover {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--white);
    transform: translateY(-1px);
}

.cart-qty-value {
    min-width: 18px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-dark);
}

.cart-item-price {
    color: var(--primary-color);
    font-weight: 700;
    margin-right: 10px;
}

.cart-item-remove {
    background: none;
    border: none;
    color: #e74c3c;
    cursor: pointer;
    font-size: 18px;
    transition: all 0.3s ease;
}

.cart-item-remove:hover {
    transform: scale(1.2);
}

.cart-empty {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-light);
}

.cart-footer {
    padding: 20px;
    border-top: 2px solid var(--primary-color);
    background: var(--light-bg);
}

.cart-summary {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 15px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.summary-row.total {
    font-size: 18px;
    font-weight: 700;
    color: var(--primary-color);
    border-top: 2px solid #e0e0e0;
    padding-top: 10px;
}

.delivery-fee {
    color: var(--text-light);
    font-size: 14px;
}

.discount-row span {
    color: var(--accent-color);
    font-weight: 700;
}

.cart-discount-note {
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--text-light);
    margin: 2px 0 14px;
}

.pay-now-btn {
    width: 100%;
    padding: 14px;
    background: var(--primary-color);
    color: var(--white);
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.pay-now-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(26, 26, 26, 0.3);
}

/* Live Counter */
.live-counter {
    position: absolute;
    top: 9px;
    right: 240px;
    width: 200px;
    height: 38px;
    background: rgba(247, 244, 244, 0.208);
    border-radius: 16px;
    padding: 8px 16px;
    display: flex;
    gap: 12px;
    z-index: 1000;
    animation: slideInRight 1s ease-out;
    cursor: pointer;
}

.counter-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.counter-item i {
    font-size: 8px;
    color: var(--primary-color);
    animation: pulse 2s infinite;
}

.counter-text {
    display: flex;
    flex-direction: column;
}

.counter-label {
    font-size: 9px;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.counter-number {
    font-size: 12px;
    font-weight: 700;
    color: var(--primary-color);
    animation: countUp 0.5s ease-out;
}

.counter-divider {
    width: 1px;
    height: 22px;
    background: linear-gradient(to bottom, transparent, var(--primary-color), transparent);
}

.live-counter:hover {
    border-color: var(--primary-color);
    background: var(--light-bg);
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
}

/* Social Buttons */
.social-buttons {
                position: fixed;
                right: 16px;
                top: 32%;
                display: flex;
                flex-direction: column;
                gap: 12px;
                z-index: 10;
            }

.social-buttons a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.08);
                text-decoration: none;
                transition: transform 0.2s ease, background 0.2s ease;
                box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            }

.social-buttons a img {
                width: 22px;
                height: 22px;
                display: block;
            }

.social-buttons a:hover {
                transform: translateX(-4px);
                background: rgba(255, 255, 255, 0.16);
            }

/* Announcement Banner */
.ad-banner {
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
    padding: 15px 40px;
    text-align: center;
    font-size: 14px;
    color: var(--primary-color);
    font-weight: 600;
    animation: slideDown 0.5s ease-out;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    font-family: "Bodoni MT Black";
}

.invisible-btn {
    position: absolute;
    top: 0;
    left: 0;
    width: 1%;
    height:1px;
    background: transparent;
    border: none;
    cursor: default;
    z-index: 1000;
}

/* Navigation Bar */
.navbar {
    background:
          radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.42), transparent 38%),
          rgba(255, 255, 255, 0.322);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 0;
    z-index: 100;
    animation-delay: 0.25s;
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
}

.logo {
    position: absolute;
    align-items: center;
    gap: 10px;
    font-size: 24px;
    font-weight: 700;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    cursor: default;
    transition: transform 0.3s ease;
}

.logo:hover {
    transform: scale(1.05);
}

.logo i {
    -webkit-text-fill-color: var(--primary-color);
}

.nav-links {
    display: flex;
    gap: 30px;
}

.nav-link {
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 500;
    position: relative;
    left: 350px;
    transition: color 0.3s ease;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient);
    transition: width 0.3s ease;
}

.nav-link:hover {
    color: var(--primary-color);
}

.nav-link:hover::after {
    width: 100%;
}

.nav-item-dropdown {
    position: relative;
    left: 350px;
    display: inline-flex;
    align-items: center;
}

.nav-link-shop,
.nav-link-collections {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    left: 0;
}

.nav-caret {
    font-size: 10px;
    transition: transform 0.25s ease;
}

.nav-item-dropdown:hover .nav-caret {
    transform: rotate(180deg);
}

.nav-dropdown-menu {
    position: absolute;
    top: 170%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 160px;
    padding: 10px;
    background: var(--white);
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(26, 26, 26, 0.16);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 150;
}

.nav-mega-menu {
    min-width: 780px;
    padding: 26px 28px;
    display: flex;
    gap: 30px;
    align-items: flex-start;
}

.nav-mega-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
    min-width: 150px;
    border-right: 1px solid #eee;
    padding-right: 24px;
}

.nav-mega-link {
    padding: 9px 10px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dark, #1e293b);
    text-decoration: none;
    text-align: left;
    transition: background 0.2s ease, color 0.2s ease;
}

.nav-mega-link:hover {
    background: #fdeef1;
    color: var(--accent-color, #f43f5e);
}

.nav-mega-banners {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    flex: 1;
}

.nav-mega-banner:nth-child(7) {
    grid-column: 2;
}

.nav-mega-links {
    display: none !important;
}

.nav-mega-banners {
    width: 100%;
    grid-auto-flow: row;
}

.nav-mega-banner {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    background: linear-gradient(135deg, #1a1a1a, #333333);
}

.nav-mega-banner img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: block;
    z-index: 0;
}

.nav-mega-banner:hover img {
    transform: scale(1.08);
}

.nav-mega-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.4) 100%);
    pointer-events: none;
    z-index: 1;
}

.nav-mega-banner span {
    position: absolute;
    left: 12px;
    bottom: 10px;
    z-index: 2;
    color: #fff;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-shadow: 0 2px 8px rgba(0,0,0,0.35);
}

@media (max-width: 1100px) {
.nav-mega-menu { min-width: 640px; }
}

.nav-collections-menu {
    min-width: 780px;
}

.nav-collections-menu .nav-mega-banners {
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

@media (max-width: 1100px) {
.nav-collections-menu { min-width: 640px; }
.nav-collections-menu .nav-mega-banners {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (prefers-reduced-motion: reduce) {
.nav-mega-banner img { transition: none !important; }
.nav-mega-banner:hover img { transform: none !important; }
}

.nav-item-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
}

.nav-item-dropdown:hover .nav-dropdown-menu,
.nav-item-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
}

@media (max-width: 768px) {
.nav-dropdown-menu { display: none; }
}

.nav-icons {
    display: flex;
    gap: 25px;
}

.nav-icon {
    color: var(--text-dark);
    font-size: 18px;
    text-decoration: none;
    position: relative;
    transition: all 0.3s ease;
    cursor: pointer;
}

.nav-icon:hover {
    color: var(--primary-color);
    transform: scale(1.2);
}

.cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--primary-color);
    color: var(--white);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
}

.spin-now {
    position: absolute;
    top: 9px;
    right: 1080px;
    background: var(--accent-color);
    color: var(--white);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
}

.spin-now:hover {
    background: var(--primary-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(26, 26, 26, 0.3);
}

.scroll-cue {
    position:absolute;
    transform:translateX(-50%);
    z-index:5;
    font-size:10px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--taupe);
    display:flex; flex-direction:column; align-items:center; gap:10px;
    opacity:0;
    animation: riseIn 1s 1.4s ease forwards;
  }

.scroll-line {
    width:1px; height:34px; background:var(--line);
    position:relative; overflow:hidden;
  }

.scroll-line::after {
    content:''; position:absolute; top:-100%; left:0; width:100%; height:100%;
    background:var(--gold);
    animation: scrollDrop 2.2s ease-in-out infinite;
  }

@keyframes scrollDrop {
    0%{top:-100%;} 60%{top:100%;} 100%{top:100%;}
  }

/* Hero Section */
.hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    min-height: calc(100vh - 80px);
}

.hero-content {
    animation: slideInLeft 0.8s ease-out;
}

.hero-title {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--text-dark);
}

.hero-subtitle {
    font-size: 18px;
    color: var(--text-light);
    margin-bottom: 30px;
    line-height: 1.6;
}

/* Buttons */
.btn {
    padding: 12px 28px;
    border: none;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.btn-primary {
    background: var(--gradient);
    color: var(--white);
    box-shadow: 0 10px 30px rgba(26, 26, 26, 0.3);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(169, 43, 43, 0.4);
}

.btn-lg {
    padding: 16px 40px;
    font-size: 16px;
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--primary-color);
    color: var(--primary-color);
}

.btn-outline:hover {
    background: var(--primary-color);
    color: var(--white);
}

.btn-small {
    padding: 8px 16px;
    font-size: 12px;
}

.btn-full {
    width: 100%;
    justify-content: center;
}

.background1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100vh + 200px);
    min-height: 820px;
    max-height: 1080px;
    object-fit: cover;
    object-position: center 18%;
    pointer-events: none;
}

.background2 {
    position: absolute;
    height: 1020px;
    width: 100%;
}

.btn1 {
    position: relative;
    left: 1125px;
    top: 450px;
    width: 250px;
    height: 70px;
    padding: 12px 28px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    opacity: 0;
}

.btn-primary1 {
    background: var(--gradient);
    color: var(--white);
    box-shadow: 0 10px 30px rgba(26, 26, 26, 0.3);
}

.btn-lg {
    padding: 16px 40px;
    font-size: 16px;
}

/* New Collections */
.collections {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 40px;
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeIn 0.6s ease-out;
}

.section-header h2 {
    font-size: 42px;
    font-weight: 800;
    margin-bottom: 10px;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.section-header p {
    font-size: 16px;
    color: var(--text-light);
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

/* Product Cards */
.product-card {
    background: var(--white);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
    animation: slideUp 0.6s ease-out both;
}

.product-card:nth-child(1) { animation-delay: 0.1s; }

.product-card:nth-child(2) { animation-delay: 0.2s; }

.product-card:nth-child(3) { animation-delay: 0.3s; }

.product-card:nth-child(4) { animation-delay: 0.4s; }

.product-card:nth-child(5) { animation-delay: 0.5s; }

.product-card:nth-child(6) { animation-delay: 0.6s; }

.product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 50px rgba(26, 26, 26, 0.2);
}

.product-image {
    position: relative;
    height: 250px;
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.product-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: var(--primary-color);
    color: var(--white);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    animation: scaleIn 0.5s ease-out;
}

.product-badge.hot {
    background: var(--accent-color);
}

.product-badge.sale {
    background: #f59e0b;
}

.product-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.product-card.show-overlay .product-overlay {
    opacity: 1;
    pointer-events: auto;
}

.product-info {
    padding: 20px;
}

.product-info h3 {
    font-size: 16px;
    margin-bottom: 10px;
    color: var(--text-dark);
}

.product-rating {
    display: flex;
    gap: 5px;
    margin-bottom: 12px;
}

.product-rating i {
    color: #fbbf24;
    font-size: 12px;
}

.product-price {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 15px;
}

.price {
    font-size: 18px;
    font-weight: 700;
    color: var(--primary-color);
}

.original-price {
    font-size: 14px;
    color: var(--text-light);
    text-decoration: line-through;
}

/* Features */
.features {
    position: relative;
    z-index: 2;
    width: min(1400px, calc(100% - 80px));
    margin: 0 auto;
    padding: 60px 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    border-radius: 20px;

    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.features .feature-item h3 {
    color: var(--text-dark);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.35);
}

.features .feature-item p {
    color: #334155;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
}

@media (max-width: 560px) {
.features {
        width: calc(100% - 32px);
        padding: 36px 22px;
        gap: 30px;
    }
}

.feature-item {
    text-align: center;
    animation: slideUp 0.6s ease-out;
}

.feature-icon {
    font-size: 48px;
    color: var(--primary-color);
    margin-bottom: 15px;
    animation: float 3s ease-in-out infinite;
}

.feature-item h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
}

.feature-item p {
    color: var(--text-light);
    line-height: 1.6;
}

/* Fashion Banner */
.fashion-img-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
}

.fashion-img {
    width: 100%;
}

.fashion-img-shop-btn {
    position: absolute;
    right: 2.5%;
    bottom: 5%;
    width: 10%;
    height: 13%;
    display: block;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    z-index: 2;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
}

.logo-gif {
    position: absolute;
    right: 70px;
    width: 200px;
    height: 200px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
}

/* About */
.about-video-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 80px 0;
    padding: 60px 0;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a1a, #333333);
    isolation: isolate;
}

.about-video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
}

.about-video-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.12);
    pointer-events: none;
}

.about {
    position: relative;
    z-index: 2;
    width: min(1400px, calc(100% - 80px));
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.55);
    animation: fadeIn 0.8s ease-out;
}

.about .about-content h2 {
    color: var(--white);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
}

.about .about-content p {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
}

.about .stat-number {
    color: var(--white);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
}

.about .stat-label {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
}

@media (max-width: 560px) {
.about {
        width: calc(100% - 32px);
        padding: 36px 22px;
    }
}

@media (prefers-reduced-motion: reduce) {
.about-video-bg { display: none; }
}

.about-content h2 {
    font-size: 42px;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--text-dark);
}

.about-content p {
    font-size: 16px;
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 30px;
    max-width: 600px;
}

.about-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 40px;
    margin-top: 40px;
}

.stat-item {
    animation: countUp 0.8s ease-out;
}

.stat-number {
    font-size: 32px;
    font-weight: 800;
    color: var(--primary-color);
}

.stat-label {
    font-size: 14px;
    color: var(--text-light);
    margin-top: 5px;
}

/* Contact */
.contact {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: none;
    margin: 0 0 0;
    padding: 60px 40px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.72);
}

.contact-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.32;
    filter: grayscale(0.15) saturate(0.8) brightness(0.9);
    z-index: 0;
    pointer-events: none;
}

.section-header,
.contact-container,
.contact-form {
    position: relative;
    z-index: 1;
}

.contact-container {
    max-width: 600px;
    margin: 0 auto;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: slideUp 0.6s ease-out;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: #1f2937;
    font-family: inherit;
    font-size: 14px;
    transition: all 0.3s ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: rgba(31, 41, 55, 0.72);
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: rgba(26, 26, 26, 0.45);
    background: rgba(255, 255, 255, 0.22);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.18);
}

.contact-form .btn {
    width: 100%;
    justify-content: center;
    padding: 14px;
    font-size: 16px;
    background: linear-gradient(135deg, rgba(17,17,17,0.95), rgba(34,34,34,0.9));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 28px rgba(17,17,17,0.28);
}

/* Login Modal */
.login-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 300;
    animation: fadeIn 0.3s ease-out;
}

.login-modal.active {
    display: flex;
}

.login-content {
    background: var(--white);
    border-radius: 15px;
    padding: 40px;
    max-width: 450px;
    width: 90%;
    animation: slideUp 0.4s ease-out;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.login-header {
    text-align: center;
    margin-bottom: 30px;
}

.login-header h2 {
    font-size: 28px;
    color: var(--primary-color);
    margin-bottom: 10px;
}

.login-header p {
    color: var(--text-light);
    font-size: 14px;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group label {
    font-weight: 600;
    color: var(--text-dark);
    font-size: 14px;
}

.form-group input {
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 14px;
    transition: all 0.3s ease;
}

.form-group input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(26, 26, 26, 0.1);
}

.login-btn {
    width: 100%;
    padding: 14px;
    background: var(--primary-color);
    color: var(--white);
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(26, 26, 26, 0.3);
    opacity: 0.6;
    cursor: not-allowed;
}

.divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0;
}

.divider::before,
.divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e0e0e0;
}

.divider span {
    color: var(--text-light);
    font-size: 14px;
    font-weight: 600;
}

.social-login {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.social-btn {
    width: 100%;
    padding: 12px;
    border: 2px solid #e0e0e0;
    background: var(--white);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.social-btn:hover {
    border-color: var(--primary-color);
    background: var(--light-bg);
    transform: translateY(-5px);
}

.social-btn i {
    font-size: 18px;
}

.social-btn.google {
    color: #f4424b;
}

.social-btn.facebook {
    color: #1877f2;
}

.login-close {
    background: none;
    border: none;
    font-size: 28px;
    color: var(--primary-color);
    cursor: pointer;
    transition: transform 1s ease;
}

.login-close:hover {
    transform: rotate(90deg);
}

/* Our Bands */
.our-bands {
    padding: 70px 0;
    overflow: hidden;
}

.bands-header {
    text-align: center;
    margin-bottom: 40px;
}

.bands-header h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-light);
}

.marquee-track {
    display: flex;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
    );
    -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
    );
}

.marquee-inner {
    display: flex;
    animation: bandScroll 28s linear infinite;
    will-change: transform;
}

.marquee-inner:hover {
    animation-play-state: paused;
}

.band-item {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 28px;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    transition: background 0.25s ease;
    cursor: pointer;
}

.band-item:hover {
    background: rgba(0, 0, 0, 0.03);
}

.band-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(30%);
    opacity: 0.85;
    transition: filter 0.3s ease, opacity 0.3s ease;
}

.band-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
}

@keyframes bandScroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

@media (max-width: 768px) {
.band-item {
        width: 140px;
        height: 90px;
        padding: 14px 18px;
    }
.marquee-inner {
        animation-duration: 18s;
    }
}

@media (prefers-reduced-motion: reduce) {
.marquee-inner {
        animation: none;
    }
.marquee-track {
        overflow-x: auto;
        mask-image: none;
        -webkit-mask-image: none;
    }
}

.footer {
    background: var(--dark-bg);
    color: var(--white);
    padding: 60px 40px 20px;
    margin-top: 80px;
}

.footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-light);
}

@keyframes slideInLeft {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(50px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-20px);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.5;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes countUp {
    from {
        opacity: 0;
        transform: scale(0.8);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes scaleIn {
    from {
        transform: scale(0);
    }
    to {
        transform: scale(1);
    }
}

@media (max-width: 768px) {
.hero {
        grid-template-columns: 1fr;
        padding: 40px 20px;
        min-height: auto;
    }
.hero-title {
        font-size: 36px;
    }
.nav-container {
        padding: 12px 20px;
    }
.nav-links {
        display: none;
    }
.products-grid {
        grid-template-columns: 1fr;
    }
.live-counter {
        top: 80px;
        right: 10px;
        padding: 6px 10px;
        width: auto;
    }
.counter-number {
        font-size: 13px;
    }
.footer-content {
        grid-template-columns: 1fr;
    }
.cart-modal {
        width: 100%;
        right: -100%;
    }
.login-content {
        width: 95%;
    }
}

@media (max-width: 480px) {
.hero-title {
        font-size: 28px;
    }
.section-header h2 {
        font-size: 28px;
    }
.collections {
        padding: 40px 20px;
    }
.contact {
        padding: 40px 20px;
    }
.login-content {
        padding: 30px 20px;
    }
}

/* Search */
.search-overlay {
    position: fixed;
    inset: 0;
    z-index: 30000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 9vh 20px 40px;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.search-overlay.active {
    opacity: 1;
    visibility: visible;
}

.search-panel {
    width: min(640px, 100%);
    max-height: 76vh;
    display: flex;
    flex-direction: column;
    background: var(--white, #fff);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
    transform: translateY(-18px) scale(0.97);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(.2, .8, .2, 1), opacity 0.3s ease;
}

.search-overlay.active .search-panel {
    transform: translateY(0) scale(1);
    opacity: 1;
}

.search-panel-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid #eee;
    flex-shrink: 0;
}

.search-panel-icon {
    font-size: 16px;
    color: var(--text-light, #64748b);
}

#searchInput {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 16px;
    color: var(--text-dark, #1e293b);
}

#searchInput::placeholder { color: #a3a9b7; }

.search-close {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #f1f1f1;
    color: var(--text-dark, #1e293b);
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, transform 0.3s ease, color 0.25s ease;
}

.search-close:hover {
    background: var(--accent-color, #f43f5e);
    color: #fff;
    transform: rotate(90deg);
}

.search-results {
    overflow-y: auto;
    padding: 10px;
    flex: 1;
}

.search-result-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s ease;
    animation: searchRowIn 0.3s ease both;
}

.search-result-item:hover,
.search-result-item.is-active {
    background: #fdeef1;
}

@keyframes searchRowIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}

.search-result-thumb {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
}

.search-result-thumb img {
