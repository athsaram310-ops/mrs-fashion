            const card = addBtn.closest('.le-card');
            if (!p || !card || !window.mrsFashionCart) return;
            if (!card.dataset.size) {
                const wrap = card.querySelector('.le-sizes-wrap');
                wrap.classList.remove('needs-size');
                void wrap.offsetWidth;
                wrap.classList.add('needs-size');
                return;
            }
            window.mrsFashionCart.addItem({
                id: p.id,
                name: `${p.group} \u2014 ${p.title}`,
                price: p.price,
                originalPrice: p.originalPrice,
                rating: 5,
                image: card.dataset.selectedFront || p.front,
                fallback: 'Product Images',
                category: 'limitedEdition',
                size: card.dataset.size,
                color: card.dataset.colorName || LIMITED_COLORS[0].name,
            });
        }
        body.addEventListener('click', onAddClick);

        const carouselTrack = document.getElementById('leTrack');
        if (carouselTrack) {
            const PER_GROUP = 2;
            const lists = ['anime', 'movies', 'tv', 'games'].map(key => {
                const seen = {};
                return CATALOGUE[key].filter(p => (seen[p.group] = (seen[p.group] || 0) + 1) <= PER_GROUP);
            });

            const mixed = [];
            const longest = Math.max.apply(null, lists.map(l => l.length));
            for (let i = 0; i < longest; i++) lists.forEach(l => { if (l[i]) mixed.push(l[i]); });

            carouselTrack.style.transition = 'none';
            carouselTrack.style.transform = 'translateX(0)';
            carouselTrack.innerHTML = mixed.map(cardHTML).join('');
            carouselTrack.addEventListener('click', onAddClick);

            const sub = section.querySelector('.section-header p');
            if (sub) sub.innerHTML = 'Anime, movie, TV &amp; game back-print tees &mdash; unisex, made for everyone';
        }

        function syncTopBtn() { topBtn.classList.toggle('show', modal.scrollTop > SHOW_TOP_BTN_AFTER); }
        modal.addEventListener('scroll', syncTopBtn, { passive: true });
        topBtn.addEventListener('click', () => {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            modal.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });

        const vip = document.createElement('div');
        vip.className = 'lev-overlay';
        vip.id = 'lehVip';
        vip.innerHTML = `
            <video class="lev-video" autoplay muted loop playsinline preload="auto" disablePictureInPicture aria-hidden="true">
                <source src="${esc(VIP_VIDEO_SRC)}" type="video/mp4">
            </video>
            <div class="lev-shade"></div>
            <div class="lev-card" role="dialog" aria-modal="true" aria-labelledby="lehVipTitle">
                <button type="button" class="lev-close" aria-label="Close">&times;</button>
                <div class="lev-form-wrap">
                    <button type="button" class="lev-back"><i class="fas fa-arrow-left"></i> Back to designs</button>
                    <div class="lev-header">
                        <i class="fas fa-crown"></i>
                        <div><h2 id="lehVipTitle">VIP Limited Edition Request</h2><p>Tell us what you'd like us to make for you</p></div>
                    </div>
                    <form class="leh-vip-form" novalidate>
                        <div class="lev-field">
                            <label for="lehVipCategory">Section</label>
                            <select id="lehVipCategory" data-f="category">
                                ${TABS.map(t => `<option value="${t.key}">${t.label}</option>`).join('')}
                            </select>
                        </div>
                        <div class="lev-field">
                            <label for="lehVipName">Name</label>
                            <input type="text" id="lehVipName" data-f="name" autocomplete="name" placeholder="Your full name">
                            <div class="lev-error">Enter your name.</div>
                        </div>
                        <div class="lev-field">
                            <label for="lehVipPhone">Phone number</label>
                            <input type="tel" id="lehVipPhone" data-f="phone" autocomplete="tel" placeholder="e.g. +94 77 123 4567">
                            <div class="lev-error">Enter a valid phone number.</div>
                        </div>
                        <div class="lev-field">
                            <label for="lehVipPrint">Print type</label>
                            <select id="lehVipPrint" data-f="print">
                                <option value="" disabled selected>Select a print type</option>
                                ${PRINT_TYPES.map(t => `<option value="${esc(t)}">${esc(t)}</option>`).join('')}
                            </select>
                            <div class="lev-error">Choose a print type.</div>
                        </div>
                        <div class="lev-field">
                            <label>Shirt color</label>
                            <div class="lev-colors" data-f="colors" role="group" aria-label="Shirt color">
                                ${SHIRT_COLORS.map(c => `<button type="button" class="lev-color" data-color="${esc(c.name)}" aria-pressed="false"><i style="background:${esc(c.hex)}"></i>${esc(c.name)}</button>`).join('')}
                            </div>
                            <div class="lev-error">Choose a shirt color.</div>
                        </div>
                        <div class="lev-field">
                            <label for="lehVipComment">Comment</label>
                            <textarea id="lehVipComment" data-f="comment" rows="3" placeholder="Movie, show, anime or game, character, size, or anything else we should know"></textarea>
                        </div>
                        <button type="submit" class="lev-submit">Submit</button>
                    </form>
                </div>
                <div class="lev-done" role="status" aria-live="polite">
                    <div class="lev-done-icon"><i class="fas fa-check"></i></div>
                    <p>Request sent. Our VIP team will contact you shortly.</p>
                    <button type="button" class="lev-done-close">Close</button>
                </div>
            </div>`;
        document.body.appendChild(vip);

        const video = vip.querySelector('.lev-video');
        video.querySelector('source').addEventListener('error', () => vip.classList.add('no-video'));
        video.addEventListener('error', () => vip.classList.add('no-video'));

        const vForm = vip.querySelector('.leh-vip-form');
        const vWrap = vip.querySelector('.lev-form-wrap');
        const vDone = vip.querySelector('.lev-done');
        const F = {};
        vip.querySelectorAll('[data-f]').forEach(el => { F[el.dataset.f] = el; });
        let selectedColor = '';

        function setInvalid(el, bad) {
            const field = el.closest('.lev-field');
            el.classList.toggle('has-error', bad);
            if (field) field.classList.toggle('invalid', bad);
        }
        F.name.addEventListener('input', () => setInvalid(F.name, false));
        F.phone.addEventListener('input', () => {
            F.phone.value = F.phone.value.replace(/[^\d+\s()-]/g, '').slice(0, 18);
            setInvalid(F.phone, false);
        });
        F.print.addEventListener('change', () => setInvalid(F.print, false));
        F.colors.addEventListener('click', (e) => {
            const chip = e.target.closest('.lev-color');
            if (!chip) return;
            selectedColor = chip.dataset.color;
            F.colors.querySelectorAll('.lev-color').forEach(c => {
                const on = c === chip;
                c.classList.toggle('active', on);
                c.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            setInvalid(F.colors, false);
        });

        function openVip() {
            vForm.reset();
            F.category.value = activeTab;
            selectedColor = '';
            F.colors.querySelectorAll('.lev-color').forEach(c => { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
            [F.name, F.phone, F.print, F.colors].forEach(el => setInvalid(el, false));
            vWrap.style.display = '';
            vDone.classList.remove('show');
            vip.classList.add('open');
            const p = video.play(); if (p !== undefined) p.catch(() => {});
            setTimeout(() => F.name.focus(), 80);
        }
        function closeVip() { vip.classList.remove('open'); video.pause(); }

        overlay.querySelector('.leh-vip').addEventListener('click', openVip);
        vip.querySelector('.lev-close').addEventListener('click', closeVip);
        vip.querySelector('.lev-back').addEventListener('click', closeVip);
        vip.querySelector('.lev-done-close').addEventListener('click', closeVip);
        vip.addEventListener('click', (e) => { if (e.target === vip || e.target.classList.contains('lev-shade')) closeVip(); });

        vForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const checks = [
                [F.name, F.name.value.trim().length > 1],
                [F.phone, F.phone.value.replace(/\D/g, '').length >= 7],
                [F.print, F.print.value !== ''],
                [F.colors, selectedColor !== ''],
            ];
            let firstBad = null;
            checks.forEach(([el, ok]) => { setInvalid(el, !ok); if (!ok && !firstBad) firstBad = el; });
            if (firstBad) { (firstBad.focus ? firstBad : firstBad.querySelector('button')).focus(); return; }

            const request = {
                section: F.category.value,
                name: F.name.value.trim(),
                phone: F.phone.value.trim(),
                printType: F.print.value,
                shirtColor: selectedColor,
                comment: F.comment.value.trim(),
                submittedAt: new Date().toISOString(),
            };

            window.mrsFashionLimitedVipRequests = window.mrsFashionLimitedVipRequests || [];
            window.mrsFashionLimitedVipRequests.push(request);

            vWrap.style.display = 'none';
            vDone.classList.add('show');
        });

        function openHub() {
            overlay.classList.add('open');
            document.documentElement.style.overflow = 'hidden';
            renderTab(activeTab);
        }
        function closeHub() {
            closeVip();
            overlay.classList.remove('open');
            document.documentElement.style.overflow = '';
        }
        seeMore.addEventListener('click', openHub);
        overlay.querySelector('.leh-close').addEventListener('click', closeHub);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeHub(); });

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            if (vip.classList.contains('open')) { e.stopPropagation(); closeVip(); }
            else if (overlay.classList.contains('open')) closeHub();
        }, true);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();

// Book Tickets: visible only on the home section
document.addEventListener('DOMContentLoaded', () => {
    const ticketBtn = document.getElementById('ticketBookingBtn');
    const home = document.getElementById('home');
    if (!ticketBtn || !home) return;

    new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            ticketBtn.classList.toggle('is-hidden', !entry.isIntersecting);
        });
    }, { threshold: 0.15 }).observe(home);
});
