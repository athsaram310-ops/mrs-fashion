        EVENTS.forEach((evt, i) => {
            const img = document.createElement('img');
            img.className = 'ticket-poster-img' + (i === 0 ? ' is-active' : '');
            img.src = evt.poster;
            img.alt = evt.name;
            img.loading = 'lazy';
            img.onerror = function () {
                this.style.display = 'none';
                posterPanel.classList.add('is-empty');
            };
            posterPanel.insertBefore(img, posterPanel.querySelector('.ticket-poster-fallback'));

            const caption = document.createElement('div');
            caption.className = 'ticket-poster-caption';
            caption.style.display = i === 0 ? 'block' : 'none';
            caption.innerHTML = `<strong>${evt.name}</strong><span>${evt.venue}</span>`;
            posterPanel.appendChild(caption);
        });

        const posterImgs = () => Array.from(posterPanel.querySelectorAll('.ticket-poster-img'));
        const posterCaptions = () => Array.from(posterPanel.querySelectorAll('.ticket-poster-caption'));

        dotsWrap.innerHTML = EVENTS.map((_, i) =>
            `<span class="ticket-poster-dot${i === 0 ? ' active' : ''}" data-index="${i}"></span>`
        ).join('');

        function showSlide(index) {
            const imgs = posterImgs();
            const captions = posterCaptions();
            imgs.forEach((im, i) => im.classList.toggle('is-active', i === index));
            captions.forEach((c, i) => { c.style.display = i === index ? 'block' : 'none'; });
            dotsWrap.querySelectorAll('.ticket-poster-dot').forEach((d, i) =>
                d.classList.toggle('active', i === index)
            );
            activeIndex = index;
        }

        function startRotation() {
            stopRotation();
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion || EVENTS.length <= 1) return;
            rotateTimer = setInterval(() => {
                showSlide((activeIndex + 1) % EVENTS.length);
            }, ROTATE_MS);
        }
        function stopRotation() {
            if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = null; }
        }

        dotsWrap.addEventListener('click', (e) => {
            const dot = e.target.closest('.ticket-poster-dot');
            if (!dot) return;
            showSlide(parseInt(dot.dataset.index, 10));
            startRotation();
        });

        EVENTS.forEach(evt => {
            const opt = document.createElement('option');
            opt.value = evt.id;
            opt.textContent = evt.name;
            eventSelect.appendChild(opt);
        });

        function currentEvent() {
            return EVENTS.find(e => e.id === eventSelect.value) || null;
        }

        function updateDependentFields() {
            const evt = currentEvent();
            if (!evt) {
                dateSelect.innerHTML = '<option value="" disabled selected>Select event first</option>';
                typeSelect.innerHTML = '<option value="" disabled selected>Select event first</option>';
                dateSelect.disabled = true;
                typeSelect.disabled = true;
                updateTotal();
                return;
            }
            dateSelect.disabled = false;
            typeSelect.disabled = false;
            dateSelect.innerHTML = '<option value="" disabled selected>Select a date</option>' +
                evt.dates.map(d => `<option value="${d}">${formatDate(d)}</option>`).join('');
            typeSelect.innerHTML = '<option value="" disabled selected>Select ticket type</option>' +
                evt.ticketTypes.map((t, i) => `<option value="${i}">${t.label} — LKR ${t.price.toLocaleString()}</option>`).join('');
            updateTotal();
        }

        function updateTotal() {
            const evt = currentEvent();
            const typeIdx = typeSelect.value;
            let price = 0;
            if (evt && typeIdx !== '') price = evt.ticketTypes[parseInt(typeIdx, 10)].price;
            totalPriceEl.textContent = `LKR ${(price * quantity).toLocaleString()}`;
        }

        eventSelect.addEventListener('change', updateDependentFields);
        typeSelect.addEventListener('change', updateTotal);

        qtyBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const dir = parseInt(btn.dataset.dir, 10);
                quantity = Math.max(1, Math.min(10, quantity + dir));
                qtyValueEl.textContent = quantity;
                updateTotal();
            });
        });

        function open() {
            modal.classList.add('active');
            document.documentElement.style.overflow = 'hidden';
            showSlide(0);
            startRotation();
        }
        function close() {
            modal.classList.remove('active');
            document.documentElement.style.overflow = '';
            stopRotation();
        }

        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) close();
        });

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const evt = currentEvent();
            const dateVal = dateSelect.value;
            const typeIdx = typeSelect.value;
            const name = nameInput.value.trim();
            const email = emailInput.value.trim();

            let firstInvalid = null;
            [[eventSelect, evt], [dateSelect, dateVal], [typeSelect, typeIdx !== '' ? typeIdx : null],
             [nameInput, name], [emailInput, email && email.includes('@') ? email : null]]
                .forEach(([el, val]) => {
                    const invalid = !val;
                    el.classList.toggle('has-error', invalid);
                    if (invalid && !firstInvalid) firstInvalid = el;
                });
            if (firstInvalid) { firstInvalid.focus(); return; }

            const ticketType = evt.ticketTypes[parseInt(typeIdx, 10)];

            const ticketItem = {
                id: 'ticket-' + evt.id + '-' + dateVal + '-' + ticketType.label.replace(/\s+/g, ''),
                name: `${evt.name} — ${ticketType.label} (${formatDate(dateVal)})`,
                price: ticketType.price,
                originalPrice: ticketType.price,
                rating: 5,
                image: evt.poster,
                fallback: 'web photo/events',
                isTicket: true,
                eventName: evt.name,
                venue: evt.venue,
                buyerName: name,
                buyerEmail: email,
            };

             if (window.mrsFashionCart) {
                for (let i = 0; i < quantity; i++) {
                    window.mrsFashionCart.addItem(ticketItem);
                }
            }

            close();
            form.reset();
            quantity = 1;
            qtyValueEl.textContent = 1;
            updateDependentFields();

            if (window.mrsFashionCheckout) {
                window.mrsFashionCheckout.open();
            } else if (window.mrsFashionCartModal) {
                window.mrsFashionCartModal.openCart();
            }
        });
    });
})();

// VIP Order
(function () {
    'use strict';

    const SIZES = ['XS', 'S', 'M', 'L', 'XL', 'XXL', '3XL'];

    const CATEGORY_LABELS = {
        new: 'New Collection',
        gift: 'Gift Collection',
        men: 'Men',
        women: 'Women',
        kids: 'Kids',
        office: 'Office',
        school: 'School',
        homeLifestyle: 'Home & Lifestyle',
        toysGames: 'Toys & Games',
    };
    const CATEGORY_ORDER = ['new', 'gift', 'men', 'women', 'kids', 'office', 'school', 'homeLifestyle', 'toysGames'];

    function escapeHTML(str) {
        return String(str).replace(/[&<>"']/g, (s) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[s]));
    }

    function getProductImage(product) {
        if (!product) return '';
        return product.image || product.img || '';
    }

    function getCatalogue(category) {
        if (!category) return [];
        if (category === 'new') {
            const pm = window.mrsFashionProductManager;
            return (pm && pm.products) || [];
        }
        if (category === 'gift') {
            return window.mrsFashionGiftProducts || [];
        }
        const shopProducts = window.mrsFashionShopProducts;
        if (!shopProducts) return [];
        return shopProducts[category] || [];
    }

    function findSiteProduct(rawName, category) {
        const query = rawName.trim().toLowerCase();
        if (!query) return null;
        const products = getCatalogue(category);
        let match = products.find(p => p.name.trim().toLowerCase() === query);
        if (!match) {
            match = products.find(p =>
                p.name.toLowerCase().includes(query) || query.includes(p.name.toLowerCase())
            );
        }
        return match || null;
    }

    function buildButton() {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'vip-order-btn';
        btn.id = 'vipOrderBtn';
        btn.setAttribute('aria-label', 'VIP Order');
        btn.innerHTML = '<img src="icon pack/vip1.png" alt="VIP Order" draggable="false">';
        document.body.appendChild(btn);
        return btn;
    }

    function buildModal() {
        const modal = document.createElement('div');
        modal.className = 'vip-modal';
        modal.id = 'vipModal';
        modal.innerHTML = `
            <div class="vip-modal-content">
                <button type="button" class="vip-modal-close" id="vipModalClose" aria-label="Close">&times;</button>
                <div class="vip-modal-header">
                    <i class="fas fa-crown"></i>
                    <h2>VIP Item Request</h2>
                </div>
                <p class="vip-modal-sub">Tell us exactly what you want and we'll add it to your cart as a VIP item.</p>
                <form id="vipOrderForm" novalidate>
                    <div class="vip-field">
                        <label for="vipCategory">Order For</label>
                        <select id="vipCategory" required>
                            <option value="" disabled selected>Select a category</option>
                            ${CATEGORY_ORDER.map(key => `<option value="${key}">${CATEGORY_LABELS[key]}</option>`).join('')}
                        </select>
                    </div>
                    <div class="vip-field vip-item-search">
                        <label for="vipItemName">Item Name</label>
                        <div class="vip-item-search-input-wrap">
                            <i class="fas fa-search vip-item-search-icon"></i>
                            <input type="text" id="vipItemName" placeholder="Select a category first" required autocomplete="off" disabled>
                        </div>
                        <div class="vip-item-dropdown" id="vipItemDropdown"></div>
                        <div class="vip-selected-item" id="vipSelectedItem">
                            <div class="vip-selected-item-thumb"><img id="vipSelectedItemImg" src="" alt=""></div>
                            <div class="vip-selected-item-info">
                                <div class="vip-selected-item-name" id="vipSelectedItemName"></div>
                                <div class="vip-selected-item-meta" id="vipSelectedItemMeta"></div>
                            </div>
                            <div class="vip-selected-item-price" id="vipSelectedItemPrice"></div>
                            <button type="button" class="vip-selected-item-clear" id="vipSelectedItemClear" aria-label="Clear selected item">&times;</button>
                        </div>
                        <p class="vip-price-note" id="vipPriceNote"></p>
                    </div>
                    <div class="vip-field-grid">
                        <div class="vip-field">
                            <label for="vipColorCode">Color Code</label>
                            <input type="text" id="vipColorCode" placeholder="e.g. #1a1a1a or Black" required autocomplete="off">
                        </div>
                        <div class="vip-field">
                            <label for="vipSize">Size</label>
                            <select id="vipSize" required>
                                <option value="" disabled selected>Select a size</option>
                                ${SIZES.map(s => `<option value="${s}">${s}</option>`).join('')}
                            </select>
                        </div>
                    </div>
                    <div class="vip-field">
                        <label for="vipComments">Comments (optional)</label>
                        <textarea id="vipComments" rows="3" placeholder="Any additional notes for this VIP order…"></textarea>
                    </div>
                    <button type="submit" class="vip-submit-btn">Submit</button>
                </form>
            </div>
        `;
        document.body.appendChild(modal);
        return modal;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btn = buildButton();
        const modal = buildModal();

        const closeBtn = document.getElementById('vipModalClose');
        const form = document.getElementById('vipOrderForm');
        const categorySelect = document.getElementById('vipCategory');
        const nameInput = document.getElementById('vipItemName');
        const dropdownEl = document.getElementById('vipItemDropdown');
        const selectedCard = document.getElementById('vipSelectedItem');
        const selectedImg = document.getElementById('vipSelectedItemImg');
        const selectedNameEl = document.getElementById('vipSelectedItemName');
        const selectedMetaEl = document.getElementById('vipSelectedItemMeta');
        const selectedPriceEl = document.getElementById('vipSelectedItemPrice');
        const selectedClearBtn = document.getElementById('vipSelectedItemClear');
        const colorInput = document.getElementById('vipColorCode');
        const sizeSelect = document.getElementById('vipSize');
        const priceNote = document.getElementById('vipPriceNote');
        const commentsInput = document.getElementById('vipComments');

        const MAX_DROPDOWN_RESULTS = 8;
        let selectedProduct = null;
        let dropdownActiveIndex = -1;

        function showSelectedPreview(product) {
            selectedProduct = product;
            selectedImg.src = getProductImage(product);
            selectedImg.alt = product.name;
            selectedNameEl.textContent = product.name;
            selectedMetaEl.textContent = CATEGORY_LABELS[categorySelect.value] || '';
            selectedPriceEl.textContent = `LKR ${product.price.toLocaleString()}`;
            selectedCard.classList.add('show');
            priceNote.textContent = '';
            priceNote.className = 'vip-price-note';
        }

        function clearSelectedPreview() {
            selectedProduct = null;
            selectedCard.classList.remove('show');
            selectedImg.src = '';
        }

        selectedClearBtn.addEventListener('click', () => {
            clearSelectedPreview();
            nameInput.value = '';
            priceNote.textContent = '';
            priceNote.className = 'vip-price-note';
            nameInput.focus();
        });

        function closeDropdown() {
            dropdownEl.classList.remove('open');
            dropdownEl.innerHTML = '';
            dropdownActiveIndex = -1;
        }

        function renderDropdown(products, query) {
            if (!products.length) {
                dropdownEl.innerHTML = `<div class="vip-item-dropdown-empty">No items found${query ? ` for “${escapeHTML(query)}”` : ''}.</div>`;
                dropdownEl.classList.add('open');
                dropdownActiveIndex = -1;
                return;
            }
            dropdownEl.innerHTML = products.map((p, i) => `
                <div class="vip-item-option" data-index="${i}">
                    <div class="vip-item-option-thumb"><img src="${getProductImage(p)}" alt="" loading="lazy" onerror="this.style.visibility='hidden';"></div>
                    <div class="vip-item-option-info">
                        <div class="vip-item-option-name">${escapeHTML(p.name)}</div>
                    </div>
                    <div class="vip-item-option-price">LKR ${p.price.toLocaleString()}</div>
                </div>
            `).join('');
            dropdownEl.classList.add('open');
            dropdownActiveIndex = -1;
        }

        function currentDropdownProducts(query) {
            const products = getCatalogue(categorySelect.value);
            const lower = query.trim().toLowerCase();
            const filtered = lower
                ? products.filter(p => p.name.toLowerCase().includes(lower))
                : products;
            return filtered.slice(0, MAX_DROPDOWN_RESULTS);
        }

        function refreshDropdown() {
            if (!categorySelect.value) { closeDropdown(); return; }
            renderDropdown(currentDropdownProducts(nameInput.value), nameInput.value.trim());
        }

        dropdownEl.addEventListener('mousedown', (e) => {
            const opt = e.target.closest('.vip-item-option');
            if (!opt) return;
            e.preventDefault();
            const idx = parseInt(opt.getAttribute('data-index'), 10);
            const products = currentDropdownProducts(nameInput.value);
            const product = products[idx];
            if (!product) return;
            nameInput.value = product.name;
            nameInput.classList.remove('has-error');
            showSelectedPreview(product);
            closeDropdown();
        });

        nameInput.addEventListener('focus', () => {
            if (categorySelect.value) refreshDropdown();
        });

        nameInput.addEventListener('input', () => {
            nameInput.classList.remove('has-error');
            if (selectedProduct && nameInput.value !== selectedProduct.name) {
                clearSelectedPreview();
            }
            if (!nameInput.value.trim()) {
                priceNote.textContent = '';
                priceNote.className = 'vip-price-note';
                refreshDropdown();
                return;
            }
            const match = findSiteProduct(nameInput.value, categorySelect.value);
            if (match) {
                priceNote.textContent = `Matched "${match.name}" — LKR ${match.price.toLocaleString()}`;
                priceNote.className = 'vip-price-note found';
            } else {
                priceNote.textContent = 'No matching product found on site — price will default to LKR 0.';
                priceNote.className = 'vip-price-note missing';
            }
            refreshDropdown();
        });

        nameInput.addEventListener('keydown', (e) => {
            const options = Array.from(dropdownEl.querySelectorAll('.vip-item-option'));
            if (!options.length) return;
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                dropdownActiveIndex = Math.min(dropdownActiveIndex + 1, options.length - 1);
                options.forEach((o, i) => o.classList.toggle('is-active', i === dropdownActiveIndex));
                options[dropdownActiveIndex].scrollIntoView({ block: 'nearest' });
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                dropdownActiveIndex = Math.max(dropdownActiveIndex - 1, 0);
                options.forEach((o, i) => o.classList.toggle('is-active', i === dropdownActiveIndex));
                options[dropdownActiveIndex].scrollIntoView({ block: 'nearest' });
            } else if (e.key === 'Enter' && dropdownActiveIndex >= 0) {
                e.preventDefault();
                options[dropdownActiveIndex].dispatchEvent(new Event('mousedown', { bubbles: true }));
            } else if (e.key === 'Escape') {
                closeDropdown();
            }
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.vip-item-search')) closeDropdown();
        });

        function refreshNameFieldForCategory(category) {
            nameInput.disabled = !category;
            nameInput.placeholder = category ? 'Search for an item…' : 'Select a category first';
            closeDropdown();
        }

        function open() {
            form.reset();
            priceNote.textContent = '';
            priceNote.className = 'vip-price-note';
            clearSelectedPreview();
            [categorySelect, nameInput, colorInput, sizeSelect].forEach(el => el.classList.remove('has-error'));
            refreshNameFieldForCategory('');
            const content = modal.querySelector('.vip-modal-content');
            if (content) {
                content.style.animation = 'none';
                void content.offsetWidth;
                content.style.animation = '';
            }
            modal.classList.add('active');
            document.documentElement.style.overflow = 'hidden';
            setTimeout(() => categorySelect.focus(), 60);
        }

        function close() {
            modal.classList.remove('active');
            document.documentElement.style.overflow = '';
            closeDropdown();
        }

        btn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) close();
        });

        categorySelect.addEventListener('change', () => {
            categorySelect.classList.remove('has-error');
            refreshNameFieldForCategory(categorySelect.value);
            nameInput.value = '';
            clearSelectedPreview();
            priceNote.textContent = '';
            priceNote.className = 'vip-price-note';
        });

        colorInput.addEventListener('input', () => colorInput.classList.remove('has-error'));
        sizeSelect.addEventListener('change', () => sizeSelect.classList.remove('has-error'));

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const category = categorySelect.value;
            const name = nameInput.value.trim();
            const color = colorInput.value.trim();
            const size = sizeSelect.value;
            const comments = commentsInput.value.trim();

            let firstInvalid = null;
            [[categorySelect, category], [nameInput, name], [colorInput, color], [sizeSelect, size]].forEach(([el, val]) => {
                const invalid = !val;
                el.classList.toggle('has-error', invalid);
                if (invalid && !firstInvalid) firstInvalid = el;
            });
            if (firstInvalid) { firstInvalid.focus(); return; }

            const match = (selectedProduct && selectedProduct.name === name)
                ? selectedProduct
                : findSiteProduct(name, category);
            const price = match ? match.price : 0;
            const categoryLabel = CATEGORY_LABELS[category] || category;

            const vipItem = {
                id: Date.now(),
                name: name,
                price: price,
                originalPrice: match ? match.originalPrice : price,
                rating: match ? match.rating : 5,
                image: match ? getProductImage(match) : '',
                fallback: match ? (match.fallback || 'Product Images') : 'Product Images',
                category: category,
                categoryLabel: categoryLabel,
                color: color,
                size: size,
                comments: comments,
                isVIP: true,
            };

            if (window.mrsFashionCart) {
                window.mrsFashionCart.addItem(vipItem);
            }

            close();
        });
    });

    document.addEventListener('DOMContentLoaded', () => {
        const cartModal = window.mrsFashionCartModal;
        if (!cartModal) return;

        cartModal.renderCartItems = function () {
            const cartItemsContainer = document.getElementById('cartItems');
            const subtotalEl = document.getElementById('subtotal');
            const totalEl = document.getElementById('totalPrice');
            const discountRowEl = document.getElementById('discountRow');
            const discountLabelEl = document.getElementById('discountLabel');
            const discountAmountEl = document.getElementById('discountAmount');

            if (this.cart.items.length === 0) {
                cartItemsContainer.innerHTML = '<div class="cart-empty"><p>Your cart is empty</p></div>';
                subtotalEl.textContent = 'LKR 0';
                if (discountRowEl) discountRowEl.style.display = 'none';
                totalEl.textContent = 'LKR 0';
                return;
            }

            cartItemsContainer.innerHTML = this.cart.items.map(item => cartItemRowHTML(item)).join('');

            bindCartItemControls(cartItemsContainer, this);

            const subtotal = this.cart.getTotalPrice();
            const discountPct = this.cart.getDiscountPercentage();
            const discountAmount = this.cart.getDiscountAmount();
            const total = this.cart.getTotalWithDelivery();

            subtotalEl.textContent = `LKR ${subtotal.toLocaleString()}`;

            if (discountRowEl) {
                if (discountPct > 0) {
                    discountRowEl.style.display = 'flex';
                    if (discountLabelEl) discountLabelEl.textContent = `Discount (${discountPct}%):`;
                    if (discountAmountEl) discountAmountEl.textContent = `- LKR ${discountAmount.toLocaleString()}`;
                } else {
                    discountRowEl.style.display = 'none';
                }
            }

            totalEl.textContent = `LKR ${total.toLocaleString()}`;
        };

        if (cartModal.isOpen) cartModal.renderCartItems();
    });
})();

// Live Chat
(function () {
    'use strict';

    const WELCOME_MSG = "Hi, welcome to MRS Fashion! If you have any questions, please post them here, and one of our representatives will contact you shortly.";
    const WELCOME_DELAY_MS = 1000;

    function buildButton() {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'live-chat-btn';
        btn.id = 'liveChatBtn';
        btn.setAttribute('aria-label', 'Live Chat');
        btn.innerHTML = '<img src="icon pack/message.gif" alt="Live Chat" draggable="false">';
        document.body.appendChild(btn);
        return btn;
    }

    function buildWindow() {
        const win = document.createElement('div');
        win.className = 'live-chat-window';
        win.id = 'liveChatWindow';
        win.innerHTML = `
            <div class="live-chat-header">
                <div class="live-chat-header-title"><i class="fas fa-comment-dots"></i> Live Chat</div>
                <button type="button" class="live-chat-close" id="liveChatCloseBtn" aria-label="Close">&times;</button>
            </div>
            <div class="live-chat-messages" id="liveChatMessages"></div>
