}

.brand-letter:nth-child(1) { animation-delay: 0.25s; }

.brand-letter:nth-child(2) { animation-delay: 0.31s; }

.brand-letter:nth-child(3) { animation-delay: 0.37s; }

.brand-letter:nth-child(4) { animation-delay: 0.43s; }

.brand-letter:nth-child(5) { animation-delay: 0.49s; }

.brand-letter:nth-child(6) { animation-delay: 0.55s; }

.brand-letter:nth-child(7) { animation-delay: 0.61s; }

.brand-letter:nth-child(8) { animation-delay: 0.67s; }

.brand-letter:nth-child(9) { animation-delay: 0.73s; }

.brand-letter:nth-child(10) { animation-delay: 0.79s; }

.brand-letter:nth-child(11) { animation-delay: 0.85s; }

@keyframes letterRise {
