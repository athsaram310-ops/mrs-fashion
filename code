.limited-edition { background: linear-gradient(165deg, #1a1a1a 0%, #3a1c2a 60%, #f43f5e 150%); }
}

/* Limited Edition Hub */
.leh-modal { padding-top: 0; }

.leh-top {
    position: sticky;
    top: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: 0 -34px 22px;
    padding: 16px 34px 14px;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #f1e3e7;
}

.leh-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
}

.leh-tab {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1.5px solid #f3dfe5;
    background: #fff8f6;
    color: var(--text-dark, #1e293b);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

.leh-tab i { font-size: 13px; color: var(--accent-color, #f43f5e); transition: color 0.25s ease; }

.leh-tab:hover { transform: translateY(-2px); border-color: var(--accent-color, #f43f5e); }

.leh-tab.active {
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 10px 24px rgba(26, 26, 26, 0.26);
}

.leh-tab.active i { color: #fff; }

.leh-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }

.leh-vip {
    height: 36px;
    padding: 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50px;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.3);
    transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.leh-vip i { color: var(--accent-color, #f43f5e); font-size: 13px; transition: color 0.25s ease; }

.leh-vip:hover,
.leh-vip:focus-visible {
    transform: translateY(-2px);
    background: var(--accent-color, #f43f5e);
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.38);
    outline: none;
}

.leh-vip:hover i,
.leh-vip:focus-visible i { color: #fff; }

.leh-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(15, 23, 42, 0.55);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.25s ease;
}

.leh-close:hover { transform: rotate(90deg); background: var(--accent-color, #f43f5e); }

.leh-empty {
    padding: 70px 20px;
    text-align: center;
    color: var(--text-light, #64748b);
}

.leh-empty i { font-size: 44px; color: var(--accent-color, #f43f5e); opacity: 0.35; margin-bottom: 14px; display: block; }

.leh-empty p { font-size: 15px; font-weight: 600; }

.leh-modal .le-top-wrap {
    position: sticky;
    bottom: 18px;
    height: 0;
    clear: both;
    z-index: 8;
    pointer-events: none;
}

.leh-modal .le-top-btn {
    position: absolute;
    right: -14px;
    bottom: 0;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 28px rgba(26, 26, 26, 0.35);
    opacity: 0;
    transform: translateY(14px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease, background 0.25s ease;
}

.leh-modal .le-top-btn.show { opacity: 1; transform: none; pointer-events: auto; }

.leh-modal .le-top-btn:hover { background: var(--accent-color, #f43f5e); }

@media (max-width: 768px) {
.leh-top { margin: 0 -18px 18px; padding: 12px 18px; flex-wrap: wrap; }
.leh-tab { padding: 9px 14px; font-size: 12.5px; }
}

@media (max-width: 560px) {
.leh-tabs { gap: 6px; }
.leh-tab span { font-size: 12px; }
.leh-vip { padding: 0 14px; letter-spacing: 0.08em; }
}

@media (prefers-reduced-motion: reduce) {
.leh-tab,
.leh-vip,
.leh-close,
.leh-modal .le-top-btn { transition: none !important; }
}

/* Book Tickets: show only on the home section */
.ticket-booking-btn {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.35s ease,
                background-position 0.6s ease,
                opacity 0.3s ease;
}

.ticket-booking-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
}
