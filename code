            const nextN = loan.paidCount + 1;
            $('scrScheduleBody').innerHTML = q.rows.map(r => `
                <tr class="scr-row-${r.status}${covered.has(r.n) ? ' covered' : ''}${r.n === nextN ? ' is-next' : ''}">
                    <td>${r.n}</td>
                    <td>${fmtDate(r.due)}</td>
                    <td>${lkr(r.amount)}</td>
