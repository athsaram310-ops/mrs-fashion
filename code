        function renderHotelList() {
            renderVendorList(
                hotelGrid, HOTEL_OPTIONS, 'Select This Hotel', 'fa-hotel',
                'Choose Your Hotel', 'Pick a property to see its wedding packages and pricing',
                'Availability and pricing vary by date and guest count. Contact us to confirm your preferred hotel.'
            );
        }

        hotelGrid.addEventListener('click', (e) => {
            const btn = e.target.closest('.wedding-hotel-select-btn');
            const card = e.target.closest('.wedding-hotel-card');
            const vendorId = (btn && btn.getAttribute('data-vendor-id')) || (card && card.getAttribute('data-vendor-id'));
            if (!vendorId) return;
            const hotel = HOTEL_OPTIONS.find(h => h.id === vendorId);
            if (hotel) renderPackages('hotel', hotel);
        });

        const VENDOR_LIST_RENDERERS = {
            studio: renderStudioList,
            design: renderDesignShopList,
            salon: renderSalonList,
            car: renderCarList,
            hotel: renderHotelList,
        };

        function renderPackages(categoryKey, vendor) {
            const data = WEDDING_PACKAGES[categoryKey];
            if (!data) return;

            hideAllPickerGrids();
            packagesGrid.style.display = 'grid';

            packagesIcon.className = 'fas ' + data.icon;
            packagesTitle.textContent = vendor ? `${data.title} — ${vendor.name}` : data.title;
            packagesSub.textContent = vendor ? `${vendor.location} · ${data.subtitle}` : data.subtitle;

            weddingBackHandler = VENDOR_LIST_RENDERERS[categoryKey] || showImageView;

            packagesGrid.innerHTML = data.tiers.map(t => `
                <div class="wedding-package-card${t.popular ? ' is-popular' : ''}">
                    ${t.popular ? '<span class="wedding-package-badge">Most Popular</span>' : ''}
                    <div class="wedding-package-tier">${t.tier}</div>
                    <div class="wedding-package-price">${t.price} <span>/ package</span></div>
                    <ul class="wedding-package-features">
                        ${t.features.map(f => `<li><i class="fas fa-check"></i>${f}</li>`).join('')}
                    </ul>
                    <button type="button" class="wedding-package-select-btn" data-category="${categoryKey}" data-tier="${t.tier}" data-vendor-name="${vendor ? vendor.name : ''}">
                        Enquire About This Package
                    </button>
                </div>
            `).join('') + `<p class="wedding-packages-note">Prices shown are indicative starting rates and may vary based on guest count, location, and season. Contact us for a custom quote.</p>`;

            showView(viewPackages);
        }

        function openModal() {
            overlay.classList.add('open');
            document.documentElement.style.overflow = 'hidden';
            showImageView();
        }

        function closeModal() {
            overlay.classList.remove('open');
            document.documentElement.style.overflow = '';
        }

        exploreBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
        });

        hotspots.forEach(spot => {
            spot.addEventListener('click', () => {
                const cat = spot.getAttribute('data-category');
                if (cat === 'jewelry') renderJewelry();
                else if (cat === 'studio') renderStudioList();
                else if (cat === 'design') renderDesignShopList();
                else if (cat === 'salon') renderSalonList();
                else if (cat === 'car') renderCarList();
                else if (cat === 'hotel') renderHotelList();
                else if (cat === 'clothing') showClothingCategories();
                else renderPackages(cat);
            });
        });

        backBtn.addEventListener('click', () => weddingBackHandler());

        packagesGrid && document.addEventListener('click', (e) => {
            const btn = e.target.closest('.wedding-package-select-btn');
            if (!btn) return;
            const vendorName = btn.getAttribute('data-vendor-name');
            const packageTitle = WEDDING_PACKAGES[btn.getAttribute('data-category')].title;
            const vendorSuffix = vendorName ? ` with ${vendorName}` : '';
            alert(`Thanks for your interest in the ${btn.getAttribute('data-tier')} ${packageTitle}${vendorSuffix} package! Our wedding team will reach out to you shortly.`);
        });
    });
})();

