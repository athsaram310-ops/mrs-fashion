.login-modal {
    overflow: hidden;
    isolation: isolate;
    background: #111;
}

.login-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
}

.login-bg-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(15, 23, 42, 0.35);
    pointer-events: none;
}

.login-content {
    position: relative;
    z-index: 2;
    max-height: 92vh;
    overflow-y: auto;
    scrollbar-width: thin;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.login-content .login-close {
    position: absolute;
    top: 14px;
    right: 18px;
    color: #fff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}

.login-content .login-close:hover { color: var(--accent-color, #f43f5e); }

.login-content .login-header h2,
.login-content .login-header p,
.login-content .form-group label,
.login-content .divider span {
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
}

.login-content .login-header p { opacity: 0.92; }

.login-content .form-group input {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    backdrop-filter: none;
}

.login-content .form-group input::placeholder { color: rgba(255, 255, 255, 0.78); }

.login-content .form-group input:focus {
    background: rgba(255, 255, 255, 0.3);
    border-color: #fff;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.18);
}

.login-content .login-btn {
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3);
}

.login-content .login-btn:hover {
    background: var(--accent-color, #f43f5e);
    opacity: 1;
    cursor: pointer;
}

.login-content .divider::before,
.login-content .divider::after { background: rgba(255, 255, 255, 0.45); }

.login-content .social-btn {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
}

.login-content .social-btn:hover {
    background: rgba(255, 255, 255, 0.32);
    border-color: #fff;
}

.login-content .social-btn.google,
.login-content .social-btn.facebook { color: #fff; }

@media (prefers-reduced-motion: reduce) {
.login-bg-video { display: none; }
}

.limited-edition {
    isolation: isolate;
    background: #111;
}

.le-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
}

.le-video-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.45), rgba(15, 23, 42, 0.25));
    pointer-events: none;
}

.limited-edition .le-inner {
    position: relative;
    z-index: 2;
}

.limited-edition .section-header h2 {
    background: none;
