    color: var(--accent-color, #f43f5e);
}

.checkout-toggle-btn i { font-size: 13px; }

.checkout-pickup-note {
    display: none;
    padding: 16px 18px;
    border-radius: 10px;
    background: #f8f5f2;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-light, #64748b);
}

.checkout-pickup-note strong { color: var(--text-dark, #1e293b); }

.checkout-shipping-box {
    padding: 16px 18px;
