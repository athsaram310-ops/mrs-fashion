}

.scroll-line {
    width: 1px;
    height: 34px;
    background: rgba(100, 116, 139, 0.25);
    position: relative;
    overflow: hidden;
}

.scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--accent-color);
    animation: scrollDrop 2.2s ease-in-out infinite;
}

@keyframes scrollDrop {
    0% { top: -100%; }
    60% { top: 100%; }
    100% { top: 100%; }
}

.cursor-glow {
    position: fixed;
    top: 0;
    left: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244, 63, 94, 0.16), rgba(26, 26, 26, 0.06) 45%, transparent 70%);
