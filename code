                </tr>`).join('');

            refreshPayState(q.total);
        }

        function renderHistory(loan) {
            const list = loan.payments || [];
            $('scrHistoryWrap').style.display = list.length ? '' : 'none';
            $('scrHistory').innerHTML = list.slice().reverse().map(pm => `
                <li>
                    <div><strong>${lkr(pm.amount)}</strong><small>${esc(pm.method)} · ${esc(pm.receipt)}</small></div>
                    <span>${fmtDate(pm.date)}</span>
