                        <span>${escapeCartText(item.color)}</span>
                    </div>` : ''}
                ${item.size ? `
                    <div class="cart-item-size" title="Size ${escapeCartText(item.size)}">
                        <span>Size</span>
                        <span class="cart-item-size-chip">${escapeCartText(item.size)}</span>
                    </div>` : ''}
                <div class="cart-item-name">${escapeCartText(item.name)}</div>
                ${item.isVIP && item.comments ? `<div class="cart-item-comment">"${escapeCartText(item.comments)}"</div>` : ''}
                <div class="cart-item-qty-controls">
                    <button type="button" class="cart-qty-btn cart-qty-decrease" ${lineAttrs} aria-label="Decrease quantity">−</button>
                    <span class="cart-qty-value">${item.quantity}</span>
                    <button type="button" class="cart-qty-btn cart-qty-increase" ${lineAttrs} aria-label="Increase quantity">+</button>
                </div>
            </div>
            ${priceHTML}
            <button class="cart-item-remove" ${lineAttrs}>
                <i class="fas fa-trash"></i>
            </button>
        </div>
    `;
}

function bindCartItemControls(container, modal) {
    const readLine = (btn) => ({
        id: btn.getAttribute('data-id'),
        color: btn.getAttribute('data-color') || null,
        size: btn.getAttribute('data-size') || null,
    });
    container.querySelectorAll('.cart-item-remove').forEach(btn => {
        btn.addEventListener('click', () => {
            const { id, color, size } = readLine(btn);
            modal.cart.removeItem(id, color, size);
            modal.renderCartItems();
        });
    });
    container.querySelectorAll('.cart-qty-increase').forEach(btn => {
        btn.addEventListener('click', () => {
            const { id, color, size } = readLine(btn);
            modal.cart.increaseQuantity(id, color, size);
            modal.renderCartItems();
        });
    });
    container.querySelectorAll('.cart-qty-decrease').forEach(btn => {
        btn.addEventListener('click', () => {
            const { id, color, size } = readLine(btn);
            modal.cart.decreaseQuantity(id, color, size);
            modal.renderCartItems();
        });
    });
}

