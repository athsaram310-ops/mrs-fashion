// Product Color Swatches
function swapProductImage(swatchEl, imageUrl) {
    if (!imageUrl) return;
    const card = swatchEl.closest('.product-card');
    const img = card ? card.querySelector('.product-image img') : null;
    if (!card || !img) return;

    card.querySelectorAll('.color-swatch').forEach(s => s.classList.toggle('active', s === swatchEl));

    card.dataset.selectedColor = swatchEl.getAttribute('data-color') || '';
    card.dataset.selectedImage = imageUrl;

    if (img.getAttribute('src') === imageUrl) return;

    img.classList.add('loading');
    const preload = new Image();
    preload.onload = () => {
        img.src = imageUrl;
        img.classList.remove('loading');
    };
    preload.onerror = () => {
        img.classList.remove('loading');
    };
    preload.src = imageUrl;
}

function getSelectedColorForCard(card) {
    if (!card) return null;
    if (card.dataset.selectedColor) return card.dataset.selectedColor;
    const activeSwatch = card.querySelector('.color-swatch.active');
    return activeSwatch ? activeSwatch.getAttribute('data-color') : null;
}

function getSelectedImageForCard(card) {
    if (!card) return null;
    if (card.dataset.selectedImage) return card.dataset.selectedImage;
    const img = card.querySelector('.product-image img');
    return img ? img.getAttribute('src') : null;
}

function debounce(func, wait) {
    let t;
    return function(...args) {
        clearTimeout(t);
        t = setTimeout(() => func.apply(this, args), wait);
    };
}

