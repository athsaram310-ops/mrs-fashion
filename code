// Upcoming Updates
document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('updates');
    const track = document.getElementById('updatesTrack');
    if (!section || !track || track.children.length < 2) return;

    const ROTATE_MS = 5000;
    const SLIDE_MS = 700;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timer = null;
    let busy = false;

    function stepSize() {
        const first = track.firstElementChild;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return first.getBoundingClientRect().width + gap;
    }

    function advance() {
        if (busy) return;
        busy = true;

        const duration = reduceMotion ? 0 : SLIDE_MS;
        track.style.transition = duration ? `transform ${duration}ms cubic-bezier(.2,.8,.2,1)` : 'none';
        track.style.transform = `translateX(-${stepSize()}px)`;

        setTimeout(() => {
            track.style.transition = 'none';
            track.appendChild(track.firstElementChild);
            track.style.transform = 'translateX(0)';
            void track.offsetWidth;
            busy = false;
        }, duration);
    }

    function start() {
        if (timer) return;
        timer = setInterval(advance, ROTATE_MS);
    }
    function stop() {
        clearInterval(timer);
        timer = null;
    }

    const glass = section.querySelector('.updates-glass');
    if (glass) {
        glass.addEventListener('mouseenter', stop);
        glass.addEventListener('mouseleave', start);
    }

    const bgVideo = section.querySelector('.updates-video-bg');
    const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                start();
                if (bgVideo) { const p = bgVideo.play(); if (p !== undefined) p.catch(() => {}); }
            } else {
                stop();
                if (bgVideo) bgVideo.pause();
            }
        });
    }, { threshold: 0.2 });
    io.observe(section);

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (section.getBoundingClientRect().top < window.innerHeight &&
                 section.getBoundingClientRect().bottom > 0) start();
    });
});

