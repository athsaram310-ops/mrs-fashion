    const allImages = rotator ? rotator.images : Array.from(mediaWrap.querySelectorAll('.ad-banner-media-img'));

    if (allImages.every((im) => im.dataset.broken === 'true')) {
        mediaWrap.classList.add('is-empty');
        return;
    }
    if (wasActive && rotator) {
        rotator.advance();
    }
}
