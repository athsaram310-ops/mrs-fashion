}

.ad-banner-media-fallback i {
    font-size: 46px;
    opacity: 0.35;
}

.ad-banner-media-fallback span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-light, #64748b);
