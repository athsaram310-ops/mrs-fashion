.scr-lookup { max-width: 460px; margin: 10px auto 6px; }

.scr-lookup .sc-submit { margin-top: 6px; }

.scr-lookup-msg { min-height: 18px; margin-bottom: 12px; font-size: 13px; font-weight: 600; line-height: 1.5; }

.scr-lookup-msg.err { color: var(--accent-color, #f43f5e); }

.scr-lookup-msg.info {
    padding: 12px 14px;
    border-radius: 10px;
    background: #fffbeb;
    border: 1.5px solid #fcd34d;
    color: #78350f;
}

.scr-demo { margin-top: 16px; text-align: center; }

.scr-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 14px;
}

.scr-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border-radius: 14px;
    background: linear-gradient(165deg, #fff8f6 0%, #fdeef1 55%, #fce3ea 100%);
}

.scr-stat span { font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-light, #64748b); }

.scr-stat strong { font-size: 24px; font-weight: 800; color: var(--primary-color, #1a1a1a); }

.scr-stat small { font-size: 12.5px; color: var(--text-light, #64748b); }

.scr-stat.is-overdue { background: #fef2f2; }

.scr-stat.is-overdue small { color: #dc2626; font-weight: 700; }

.scr-progress {
    height: 8px;
    margin-bottom: 20px;
    border-radius: 8px;
    background: #eee;
    overflow: hidden;
}

.scr-progress i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--accent-color, #f43f5e), #fb7185);
    transition: width 0.8s ease;
}

.scr-table-wrap {
    max-height: 330px;
    overflow: auto;
    border: 1.5px solid #eee;
    border-radius: 12px;
    background: #fff;
}

.scr-table { width: 100%; border-collapse: collapse; font-size: 13px; }

.scr-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 10px 12px;
    text-align: left;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-light, #64748b);
    background: #f8f8f9;
}

.scr-table td { padding: 10px 12px; border-top: 1px solid #f1f1f1; color: var(--text-dark, #1e293b); }

.scr-table tr.is-next td { font-weight: 700; }

.scr-table tr.covered td { background: #fdeef1; }

.scr-table tr.scr-row-paid td { color: var(--text-light, #64748b); }

.scr-table tr.scr-row-overdue td:nth-child(2) { color: #dc2626; font-weight: 700; }

.scr-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.03em;
    white-space: nowrap;
}

.scr-badge-paid { background: #ecfdf5; color: #15803d; }

.scr-badge-upcoming { background: #f1f5f9; color: #475569; }

.scr-badge-today { background: #fef3c7; color: #b45309; }

.scr-badge-overdue { background: #fee2e2; color: #dc2626; }

.scr-table tr.covered .scr-badge { background: var(--accent-color, #f43f5e); color: #fff; }

.scr-sub { margin: 22px 0 12px; font-size: 13px; }

.scr-history { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; max-height: 150px; overflow: auto; }

.scr-history li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #fff;
    border: 1.5px solid #eee;
    font-size: 13px;
}

.scr-history li strong { display: block; color: var(--text-dark, #1e293b); }

.scr-history li small { color: var(--text-light, #64748b); font-size: 11.5px; }

.scr-history li > span { color: var(--text-light, #64748b); font-size: 12px; white-space: nowrap; }

.scr-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }

.scr-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    border: 1.5px solid #e2e2e2;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
}

.scr-option:hover { border-color: var(--primary-color, #1a1a1a); }

.scr-option.selected { border-color: var(--accent-color, #f43f5e); background: #fdeef1; }

.scr-option input { width: 17px; height: 17px; flex-shrink: 0; accent-color: var(--accent-color, #f43f5e); cursor: pointer; }

.scr-option-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }

.scr-option-text strong { font-size: 14px; color: var(--text-dark, #1e293b); }

.scr-option-text small { font-size: 12px; color: var(--text-light, #64748b); }

.scr-option-text select {
    margin-left: 6px;
    padding: 4px 8px;
    border: 1.5px solid #e2e2e2;
    border-radius: 6px;
    font-family: inherit;
    font-size: 12px;
    background: #fff;
}

.scr-option-amt { font-size: 14px; font-weight: 800; color: var(--text-dark, #1e293b); white-space: nowrap; }

.scr-method {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 16px;
    border: 1.5px solid #e2e2e2;
    border-radius: 10px;
    overflow: hidden;
}

.scr-method-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border: none;
    border-left: 1.5px solid #e2e2e2;
    background: #fff;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-dark, #1e293b);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.scr-method-btn:first-child { border-left: none; }

.scr-method-btn.active { background: #fdeef1; color: var(--accent-color, #f43f5e); }

.scr-wallet-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    margin-bottom: 8px;
    border-radius: 10px;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff;
    font-size: 13px;
}

.scr-wallet-row strong { font-size: 16px; }

.scr-pay-msg { min-height: 16px; margin-bottom: 8px; font-size: 12.5px; font-weight: 600; }

.scr-pay-msg.err { color: var(--accent-color, #f43f5e); }

.scr-breakdown {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    padding: 14px 16px;
    border-radius: 12px;
    background: #fff;
    border: 1.5px dashed #e3d5da;
    font-size: 13.5px;
}

.scr-breakdown > div { display: flex; justify-content: space-between; color: var(--text-light, #64748b); }

.scr-breakdown strong { color: var(--text-dark, #1e293b); }

.scr-br-total { padding-top: 8px; border-top: 1px solid #eee; font-size: 16px; font-weight: 800; }

.scr-breakdown .scr-br-total span,
.scr-breakdown .scr-br-total strong { color: var(--text-dark, #1e293b); }

.sc-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

.scr-paidoff {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 40px 10px;
    text-align: center;
    color: var(--text-light, #64748b);
    font-size: 13.5px;
}

.scr-paidoff i { font-size: 44px; color: #16a34a; }

.scr-paidoff strong { font-size: 17px; color: var(--text-dark, #1e293b); }

.scr-receipt {
    max-width: 380px;
    margin: 0 auto 20px;
    padding: 16px 20px;
    border-radius: 14px;
    background: #f8f8f9;
    text-align: left;
}

.scr-receipt > div { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 13.5px; color: var(--text-light, #64748b); }

.scr-receipt strong { color: var(--text-dark, #1e293b); text-align: right; }

.scr-receipt-total { margin: 4px 0; padding: 10px 0 !important; border-top: 1px dashed #d8d8dc; border-bottom: 1px dashed #d8d8dc; font-size: 15px !important; }

.scr-done-actions { display: flex; flex-direction: column; align-items: center; gap: 12px; }

.scr-link-btn { background: none; border: none; font-family: inherit; font-size: 13.5px; font-weight: 700; color: var(--text-light, #64748b); cursor: pointer; text-decoration: underline; }

.scr-link-btn:hover { color: var(--accent-color, #f43f5e); }

@media (max-width: 900px) {
.scr-stats { grid-template-columns: 1fr; }
}

@media (max-width: 560px) {
.scc-grid { grid-template-columns: 1fr; }
.scr-stat strong { font-size: 20px; }
}

@media (prefers-reduced-motion: reduce) {
.scr-view.show { animation: none; }
.scc-card,
.scc-card em i,
.scr-progress i { transition: none !important; }
.scc-card:hover { transform: none; }
}

.nav-link {
    left: 290px;
}

.nav-item-dropdown {
    left: 290px;
}

.nav-link-shop,
.nav-link-collections {
    left: 0;
}

.spin-now {
    right: 1130px;
}

