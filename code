            </form>
        `;
        document.body.appendChild(win);
        return win;
    }

    function appendMessage(container, text, who) {
        const msg = document.createElement('div');
        msg.className = 'live-chat-msg ' + who;
        msg.textContent = text;
        container.appendChild(msg);
        container.scrollTop = container.scrollHeight;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btn = buildButton();
        const win = buildWindow();
        const closeBtn = document.getElementById('liveChatCloseBtn');
        const messagesEl = document.getElementById('liveChatMessages');
        const form = document.getElementById('liveChatForm');
        const input = document.getElementById('liveChatInput');

        let welcomeShown = false;
        let welcomeTimer = null;

        function open() {
            win.classList.add('open');
            requestAnimationFrame(() => win.classList.add('show'));
            btn.classList.add('is-hidden');

            if (!welcomeShown) {
                welcomeTimer = setTimeout(() => {
                    appendMessage(messagesEl, WELCOME_MSG, 'agent');
                    welcomeShown = true;
                }, WELCOME_DELAY_MS);
            }
            setTimeout(() => input.focus(), 260);
        }

        function close() {
            win.classList.remove('show');
            btn.classList.remove('is-hidden');
            if (welcomeTimer) { clearTimeout(welcomeTimer); welcomeTimer = null; }
            setTimeout(() => win.classList.remove('open'), 250);
        }

        btn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const text = input.value.trim();
            if (!text) return;
            appendMessage(messagesEl, text, 'user');
            input.value = '';
        });
    });
