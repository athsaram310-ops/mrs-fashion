}

.checkout-field.has-error { border-color: var(--accent-color, #f43f5e); }

.checkout-row { display: flex; gap: 12px; }

.checkout-row > * { flex: 1; min-width: 0; }

.checkout-stack { display: flex; flex-direction: column; gap: 12px; }

.checkout-check {
