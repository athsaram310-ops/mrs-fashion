        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
    }
.ad-banner-media img,
.ad-banner-media video,
.ad-banner-media-img {
        transition: none !important;
    }
.ad-banner-card:hover .ad-banner-media img,
.ad-banner-card:hover .ad-banner-media video {
