            const qSettle = getQuote(loan, 'settle', 0);
            const q = option === 'settle' ? qSettle : (option === 'ahead' && qAhead ? qAhead : qNext);

            $('scrOptNextAmt').textContent = lkr(qNext.total);
            $('scrOptNextNote').textContent = qNext.lateFee ? `Includes ${lkr(qNext.lateFee)} late charge` : `Installment ${loan.paidCount + 1} of ${loan.months}`;
