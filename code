// E-Wallet
(function () {
    document.addEventListener('DOMContentLoaded', () => {
        const walletWrap   = document.querySelector('.wallet-wrap');
        const iconBtn       = document.getElementById('walletIconBtn');
        const panel          = document.getElementById('walletPanel');
        if (!walletWrap || !iconBtn || !panel) return;

        const viewMain       = document.getElementById('walletViewMain');
        const viewDeposit    = document.getElementById('walletViewDeposit');
        const viewSuccess    = document.getElementById('walletViewSuccess');

        const balanceEl      = document.getElementById('walletBalanceValue');
        const depositBtn     = document.getElementById('walletDepositBtn');
        const backBtn        = document.getElementById('walletBackBtn');
        const closeBtn       = document.getElementById('walletCloseBtn');
        const closeBtn2      = document.getElementById('walletCloseBtn2');
        const doneBtn        = document.getElementById('walletDoneBtn');

        const form           = document.getElementById('walletDepositForm');
        const amountField    = document.getElementById('walletAmount');
        const nameField      = document.getElementById('walletCardName');
        const numberField    = document.getElementById('walletCardNumber');
        const expiryField    = document.getElementById('walletCardExpiry');
        const cvvField       = document.getElementById('walletCardCvv');
        const payBtn         = document.getElementById('walletPayBtn');
        const successText    = document.getElementById('walletSuccessText');

        let balance = 1000;
        let isOpen = false;

        function formatBalance(n) {
            return n.toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function renderBalance() {
            balanceEl.textContent = formatBalance(balance);
        }

        window.mrsFashionWallet = {
            getBalance: () => balance,
            setBalance: (n) => {
                balance = Math.max(0, n);
                renderBalance();
            },
            formatBalance
        };

        function showView(view) {
            [viewMain, viewDeposit, viewSuccess].forEach(v => v.classList.remove('active'));
            view.classList.add('active');
        }

        function resetDepositForm() {
            form.reset();
            [amountField, nameField, numberField, expiryField, cvvField].forEach(f => f.classList.remove('has-error'));
            payBtn.disabled = false;
            payBtn.textContent = 'Pay';
        }

        function openPanel() {
            showView(viewMain);
            renderBalance();
            panel.classList.add('open');
            isOpen = true;
        }

        function closePanel() {
            panel.classList.remove('open');
            isOpen = false;
            setTimeout(() => {
                if (!isOpen) { resetDepositForm(); showView(viewMain); }
            }, 220);
        }

        iconBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (isOpen) closePanel(); else openPanel();
        });

        [closeBtn, closeBtn2].forEach(btn => btn && btn.addEventListener('click', closePanel));

        document.addEventListener('click', (e) => {
            if (isOpen && !walletWrap.contains(e.target)) closePanel();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen) closePanel();
        });

        depositBtn.addEventListener('click', () => {
            resetDepositForm();
            showView(viewDeposit);
            amountField.focus();
        });

        backBtn.addEventListener('click', () => {
            resetDepositForm();
            showView(viewMain);
        });

        doneBtn.addEventListener('click', () => {
            resetDepositForm();
            showView(viewMain);
            renderBalance();
        });

        amountField.addEventListener('input', () => {
            amountField.value = amountField.value.replace(/[^\d]/g, '').slice(0, 9);
            amountField.classList.remove('has-error');
        });
        numberField.addEventListener('input', () => {
            const digits = numberField.value.replace(/\D/g, '').slice(0, 16);
            numberField.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
            numberField.classList.remove('has-error');
        });
        expiryField.addEventListener('input', () => {
            const digits = expiryField.value.replace(/\D/g, '').slice(0, 4);
            expiryField.value = digits.length > 2 ? `${digits.slice(0, 2)} / ${digits.slice(2)}` : digits;
            expiryField.classList.remove('has-error');
        });
        cvvField.addEventListener('input', () => {
            cvvField.value = cvvField.value.replace(/\D/g, '').slice(0, 4);
            cvvField.classList.remove('has-error');
        });
        nameField.addEventListener('input', () => nameField.classList.remove('has-error'));

        function validateExpiry(value) {
            const match = value.match(/^(\d{2})\s*\/\s*(\d{2})$/);
            if (!match) return false;
            const month = parseInt(match[1], 10);
            return month >= 1 && month <= 12;
        }

        function validateDeposit() {
            let valid = true;
            const amount = parseInt(amountField.value, 10);
            if (!amount || amount <= 0) { amountField.classList.add('has-error'); valid = false; }
            if (nameField.value.trim().length < 2) { nameField.classList.add('has-error'); valid = false; }
            if (numberField.value.replace(/\D/g, '').length < 13) { numberField.classList.add('has-error'); valid = false; }
            if (!validateExpiry(expiryField.value.trim())) { expiryField.classList.add('has-error'); valid = false; }
            if (cvvField.value.length < 3) { cvvField.classList.add('has-error'); valid = false; }
            return valid;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (!validateDeposit()) return;

            const amount = parseInt(amountField.value, 10);
            payBtn.disabled = true;
            payBtn.textContent = 'Processing...';

            setTimeout(() => {
                balance += amount;
                successText.textContent = `LKR ${amount.toLocaleString()} has been added to your e-wallet.`;
                showView(viewSuccess);
            }, 900);
        });
    });
})();

