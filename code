        function updateTotals() {
            const cart = window.mrsFashionCart;
            const subtotal = cart ? cart.getTotalPrice() : 0;

            let discountPct = cart ? cart.getDiscountPercentage() : 0;
            let discountLabel = `Discount (${discountPct}%)`;
            if (appliedPromoPct !== null) {
                discountPct = appliedPromoPct;
                discountLabel = `Promo code (${discountPct}%)`;
            }
            const discountAmount = Math.round(subtotal * (discountPct / 100));

            subtotalEl.textContent = `LKR ${subtotal.toLocaleString()}`;

            if (discountPct > 0 && subtotal > 0) {
                discountRowEl.style.display = 'flex';
