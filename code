document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.ad-banner-card');
    if (!cards.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    cards.forEach((card, index) => initAdBanner(card, index));

    function initAdBanner(card, index) {
        const DISMISS_KEY = 'mrsFashionAdBannerDismissed:' + (card.id || ('ad-banner-' + index));

        if (sessionStorage.getItem(DISMISS_KEY) === '1') {
            card.remove();
            return;
        }

        const mediaWrap = card.querySelector('.ad-banner-media');
        const images = mediaWrap ? Array.from(mediaWrap.querySelectorAll('.ad-banner-media-img')) : [];

        if (reduceMotion) {
            card.classList.add('in-view');
        } else {
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        card.classList.add('in-view');
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
            revealObserver.observe(card);
        }

        if (images.length && mediaWrap) {
            let activeIndex = images.findIndex((im) => im.classList.contains('is-active'));
            if (activeIndex === -1) {
                activeIndex = 0;
                images[0].classList.add('is-active');
            }

            function nextWorkingIndex(from) {
                for (let step = 1; step <= images.length; step++) {
                    const candidate = (from + step) % images.length;
                    if (images[candidate].dataset.broken !== 'true') return candidate;
                }
                return -1;
            }

            function advance() {
                const next = nextWorkingIndex(activeIndex);
                if (next === -1 || next === activeIndex) return;
                images[activeIndex].classList.remove('is-active');
                images[next].classList.add('is-active');
                activeIndex = next;
            }

            adBannerRotators.set(mediaWrap, { images, advance });

            if (images.length > 1) {
                setInterval(advance, AD_BANNER_ROTATE_MS);
            }
        }

        const dismissBtn = card.querySelector('.ad-banner-dismiss');
        if (dismissBtn) {
            dismissBtn.addEventListener('click', () => {
                card.classList.add('is-dismissed');
                sessionStorage.setItem(DISMISS_KEY, '1');
                card.addEventListener('transitionend', () => card.remove(), { once: true });
            });
        }
    }
});

