            const selectedPayment = payList.querySelector('input[name="checkoutPayment"]:checked');
            const selectedPaymentValue = selectedPayment ? selectedPayment.value : null;

            if (selectedPaymentValue === 'koko') {
                const invalid = !kokoMobileField || kokoMobileField.value.replace(/\D/g, '').length < 9;
                if (kokoMobileField) kokoMobileField.classList.toggle('has-error', invalid);
                if (invalid) {
                    if (kokoDetails) kokoDetails.classList.add('show');
                    kokoMobileField.focus();
                    return;
                }
            } else if (selectedPaymentValue === 'card') {
                const cardChecks = [
                    { field: cardNameField, valid: v => v.trim().length > 0 },
                    { field: cardNumberField, valid: v => v.replace(/\s+/g, '').length >= 13 },
                    { field: cardExpiryField, valid: v => /^\d{2}\s*\/\s*\d{2}$/.test(v.trim()) },
                    { field: cardCvvField, valid: v => /^\d{3,4}$/.test(v.trim()) },
                ];
                let firstInvalidCardField = null;
                cardChecks.forEach(({ field, valid }) => {
                    if (!field) return;
                    const invalid = !valid(field.value || '');
                    field.classList.toggle('has-error', invalid);
                    if (invalid && !firstInvalidCardField) firstInvalidCardField = field;
                });
                if (firstInvalidCardField) {
                    if (cardDetails) cardDetails.classList.add('show');
                    firstInvalidCardField.focus();
                    return;
                }
            } else if (selectedPaymentValue === 'binance') {
                const invalid = !binanceIdField || binanceIdField.value.trim().length === 0;
                if (binanceIdField) binanceIdField.classList.toggle('has-error', invalid);
                if (invalid) {
                    if (binanceDetails) binanceDetails.classList.add('show');
                    binanceIdField.focus();
                    return;
                }
            } else if (selectedPaymentValue === 'bybit') {
                const invalid = !bybitIdField || bybitIdField.value.trim().length === 0;
                if (bybitIdField) bybitIdField.classList.toggle('has-error', invalid);
                if (invalid) {
                    if (bybitDetails) bybitDetails.classList.add('show');
                    bybitIdField.focus();
                    return;
                }
            } else if (selectedPaymentValue === 'paypal') {
                const emailVal = (paypalEmailField && paypalEmailField.value || '').trim();
                const invalid = !emailVal.includes('@');
                if (paypalEmailField) paypalEmailField.classList.toggle('has-error', invalid);
                if (invalid) {
                    if (paypalDetails) paypalDetails.classList.add('show');
                    paypalEmailField.focus();
                    return;
                }
            } else if (selectedPaymentValue === 'ewallet') {
                const insufficient = renderEwalletState(currentGrandTotal);
                if (insufficient) {
                    if (ewalletDetails) ewalletDetails.classList.add('show');
                    return;
                }
            }

            payBtn.disabled = true;
            payBtn.textContent = 'Processing…';

            setTimeout(() => {
                if (selectedPaymentValue === 'ewallet' && window.mrsFashionWallet) {
                    window.mrsFashionWallet.setBalance(window.mrsFashionWallet.getBalance() - currentGrandTotal);
                }

                const orderId = 'MF' + Math.floor(10000 + Math.random() * 89999);
                document.getElementById('checkoutConfirmOrderId').textContent = `Order #${orderId}`;

                if (window.mrsFashionCart) {
                    window.mrsFashionCart.items = [];
                    window.mrsFashionCart.saveCart();
                    window.mrsFashionCart.updateCartDisplay();
                }

                formState.style.display = 'none';
                confirmState.classList.add('show');
            }, 1100);
        });

        document.getElementById('checkoutConfirmDone').addEventListener('click', close);

        window.mrsFashionCheckout = { open, close };
    });
})();

