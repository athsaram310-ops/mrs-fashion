#cartModal {
    z-index: 40000 !important;
}

/* Upcoming Updates */
.updates-section {
    position: relative;
    isolation: isolate;
    max-width: 1400px;
    margin: 100px auto;
    padding: 76px 40px 90px;
    border-radius: 28px;
    background: linear-gradient(165deg, #fff8f6 0%, #fdeef1 60%, #fce3ea 100%);
    overflow: hidden;
}

.updates-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
}

.updates-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.18));
    pointer-events: none;
}

.updates-section::before {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 1;
    border: 1.5px dashed rgba(255, 255, 255, 0.35);
    border-radius: 22px;
    pointer-events: none;
}

.updates-header {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
}

.updates-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(244, 63, 94, 0.85);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
}

.updates-header h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    margin-bottom: 10px;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
}

.updates-header p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
}

.updates-glass {
    position: relative;
    z-index: 2;
    margin-top: 56px;
    padding: 20px 28px 28px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.updates-glass {
    --visible: 3;
    --gap: 28px;
}

.updates-viewport {
    overflow: hidden;

    padding: 28px 4px 24px;
    margin: -8px -4px -12px;
}

.updates-track {
    display: flex;
    gap: var(--gap);
    width: 100%;
    align-items: stretch;
    will-change: transform;
}

.update-card {
    position: relative;
    flex: 0 0 calc((100% - (var(--gap) * (var(--visible) - 1))) / var(--visible));
    min-width: 0;
    background: var(--white, #fff);
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(26, 26, 26, 0.12);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
}

.update-card:hover {
    box-shadow: 0 18px 46px rgba(26, 26, 26, 0.22);
    transform: translateY(-6px);
}

.update-tag {
    position: absolute;
    top: -14px;
    left: 22px;
    z-index: 3;
    background: var(--primary-color, #1a1a1a);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 16px 7px 24px;
    border-radius: 3px 9px 9px 3px;
    transform: rotate(-4deg);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.2);
}

.update-tag::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fdeef1;
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.55);
}

.update-tag::after {
    content: '';
    position: absolute;
    left: 9px;
    top: -11px;
    width: 1px;
    height: 12px;
    background: rgba(26, 26, 26, 0.35);
}

.update-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 18px 18px 0 0;
    background: linear-gradient(135deg, #f5f5f5, #ece0e2);
}

.update-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(.2, .8, .2, 1);
}

.update-card:hover .update-card-media img { transform: scale(1.06); }

.update-media-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52px;
    color: var(--accent-color, #f43f5e);
    opacity: 0.32;
}

.update-card-body { padding: 24px 24px 28px; }

.update-card-body h3 {
    font-size: 19px;
    font-weight: 800;
    margin-bottom: 10px;
    color: var(--text-dark, #1e293b);
}

.update-card-body p {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-light, #64748b);
}

@media (max-width: 1000px) {
.updates-glass { --visible: 2; }
}

@media (max-width: 768px) {
.updates-section {
        padding: 56px 18px 70px;
        margin: 60px auto;
        border-radius: 20px;
    }
.updates-glass { margin-top: 40px; padding: 16px 16px 22px; --gap: 20px; }
}

@media (max-width: 640px) {
.updates-glass { --visible: 1; }
}

@media (prefers-reduced-motion: reduce) {
.updates-video-bg { display: none; }
.update-card,
.update-card-media img { transition: none !important; }
.update-card:hover { transform: none; }
.update-card:hover .update-card-media img { transform: none; }
}

/* Footer */
.site-footer {
    --f-ink: #15121a;
    --f-ink-2: #211622;
    --f-accent: #f43f5e;
    --f-gold: #e8b84b;
    --f-cream: #fdeef1;
    --f-text: #c9cdd8;
    --f-text-dim: #85889a;

    position: relative;
    overflow: hidden;
    margin-top: 0;
    padding-top: 44px;
    background: linear-gradient(160deg, var(--f-ink) 0%, var(--f-ink-2) 100%);
    color: var(--f-text);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.footer-hem {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
}

.footer-hem-fill {
    display: block;
    width: 0%;
    border-top: 2px dashed var(--f-gold);
    opacity: 0.85;
    transition: width 1.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.footer-hem-fill::after {
    content: '';
    position: absolute;
    right: -6px;
    top: -6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--f-gold);
    box-shadow: 0 0 12px rgba(232, 184, 75, 0.65);
    opacity: 0;
    transition: opacity 0.3s ease 0.3s;
}

.footer-hem-fill.in-view { width: 100%; }

.footer-hem-fill.in-view::after { opacity: 1; }

.footer-watermark {
    position: absolute;
    top: 26px;
    left: 50%;
    z-index: 0;
    transform: translateX(-50%);
    font-size: clamp(64px, 15vw, 220px);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 3px rgba(253, 238, 241, 0.123);
    pointer-events: none;
    user-select: none;
    animation: footerWatermarkDrift 16s ease-in-out infinite;
}

@keyframes footerWatermarkDrift {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(calc(-50% + 16px), -6px); }
}

.footer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
    gap: 50px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 74px 40px 60px;
}

.footer-logo {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin-bottom: 14px;
    background: linear-gradient(135deg, #ffffff, var(--f-cream));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.footer-tagline {
    font-size: 14px;
    line-height: 1.7;
    color: var(--f-text-dim);
    max-width: 280px;
    margin-bottom: 26px;
}

.footer-social { display: flex; gap: 12px; }

.footer-social-icon {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    color: var(--f-text);
    text-decoration: none;
    font-size: 15px;
    transform-origin: top center;
    transition: background 0.25s ease, color 0.25s ease;
}

.footer-social-icon::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 1px;
    height: 9px;
    background: rgba(255, 255, 255, 0.22);
    transform: translateX(-50%);
}

.footer-social-icon:hover {
    background: var(--f-accent);
    color: #fff;
    animation: footerTagSwing 0.6s ease;
}

@keyframes footerTagSwing {
    0%   { transform: rotate(0deg); }
    25%  { transform: rotate(-12deg); }
    55%  { transform: rotate(9deg); }
    80%  { transform: rotate(-4deg); }
    100% { transform: rotate(0deg); }
}

.footer-heading {
    position: relative;
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 24px;
}

.footer-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -9px;
    width: 24px;
    height: 2px;
    background: var(--f-accent);
}

.footer-links { list-style: none; display: flex; flex-direction: column; gap: 13px; }

.footer-links a {
    position: relative;
    color: var(--f-text-dim);
    text-decoration: none;
    font-size: 14.5px;
    transition: color 0.25s ease;
}

.footer-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 0;
    height: 1px;
    background: var(--f-accent);
    transition: width 0.3s ease;
}

.footer-links a:hover { color: #fff; }

.footer-links a:hover::after { width: 100%; }

.footer-col-tag { display: flex; justify-content: flex-start; }

.footer-tag {
    position: relative;
    max-width: 280px;
    padding: 26px 24px 22px 30px;
    border-radius: 4px 16px 16px 4px;
    background: var(--f-cream);
    color: var(--f-ink);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.38);
    transform: rotate(-3deg);
    transform-origin: top left;
    animation: footerTagSway 5.5s ease-in-out infinite;
}

.footer-tag::before {
    content: '';
    position: absolute;
    left: 16px;
    top: -34px;
    width: 1px;
    height: 34px;
    background: rgba(255, 255, 255, 0.3);
}

.footer-tag-hole {
    position: absolute;
    left: 12px;
    top: 22px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--f-ink-2);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.55);
}

@keyframes footerTagSway {
    0%, 100% { transform: rotate(-3deg); }
    50%      { transform: rotate(1.5deg); }
}

.footer-tag-title { font-size: 17px; font-weight: 800; margin-bottom: 6px; }

.footer-tag-sub { font-size: 12.5px; line-height: 1.55; color: #5b5560; margin-bottom: 16px; }

.footer-tag-form { display: flex; gap: 8px; margin-bottom: 10px; }

.footer-tag-form input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 1.5px solid rgba(26, 26, 26, 0.15);
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    background: #fff;
}

.footer-tag-form input:focus {
    outline: none;
    border-color: var(--f-ink);
}

.footer-tag-form button {
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    background: var(--f-ink);
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.25s ease, transform 0.25s ease;
}

.footer-tag-form button:hover:not(:disabled) { background: var(--f-accent); transform: translateY(-2px); }

.footer-tag-form button:disabled { opacity: 0.75; cursor: default; }

.footer-tag-note { font-size: 10.5px; line-height: 1.5; color: #948d97; }

.footer-divider {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
}

.footer-bottom {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 26px 40px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12.5px;
    color: var(--f-text-dim);
}

.footer-legal { display: flex; gap: 22px; }

.footer-legal a { color: var(--f-text-dim); text-decoration: none; transition: color 0.25s ease; }

.footer-legal a:hover { color: #fff; }

.footer-to-top {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
}

.footer-to-top:hover {
    background: var(--f-accent);
    border-color: var(--f-accent);
    transform: translateY(-4px);
}

@media (max-width: 900px) {
.footer-grid { grid-template-columns: 1fr 1fr; }
.footer-col-tag { grid-column: 1 / -1; justify-content: flex-start; margin-top: 10px; }
}

@media (max-width: 560px) {
.footer-grid { grid-template-columns: 1fr; padding: 64px 24px 44px; gap: 38px; }
.footer-hem { padding: 0 24px; }
.footer-bottom { padding: 24px 24px 30px; flex-direction: column; align-items: flex-start; }
.footer-tagline { max-width: none; }
.footer-tag { max-width: none; }
}

@media (prefers-reduced-motion: reduce) {
.footer-watermark,
.footer-tag,
.footer-social-icon:hover {
        animation: none !important;
    }
.footer-hem-fill {
        transition: none !important;
        width: 100% !important;
    }
.footer-hem-fill::after { transition: none !important; opacity: 1; }
.footer-to-top:hover { transform: none; }
}

/* Video Showcase */
.video-showcase {
    width: 100%;
    margin: 0 auto;
    background-color: transparent;
    transition: background-color 0.8s cubic-bezier(.2,.8,.2,1);
}

.video-showcase-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4/1;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a1a, #333333);
    box-shadow: 0 20px 50px rgba(26, 26, 26, 0.22);

    opacity: 0;
    transform: translateY(36px);
    filter: blur(4px);
    transition: opacity 0.8s cubic-bezier(.2,.8,.2,1),
                transform 0.8s cubic-bezier(.2,.8,.2,1),
                filter 0.8s ease;
}

.video-showcase-frame.in-view {
    opacity: 1;
    transform: translateY(0);
    filter: none;
}

.video-showcase-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
}

@media (max-width: 768px) {
.video-showcase { padding: 18px 20px; margin: 70px auto; }
.video-showcase-frame { border-radius: 14px; }
}

@media (prefers-reduced-motion: reduce) {
.video-showcase-frame {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
    }
.video-showcase {
        transition: none !important;
    }
}

/* Ad Banners */
.ad-banner-section {
    max-width: 1700px;
    margin: 70px auto;
    padding: 0 40px;
}

.ad-banner-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    background: linear-gradient(165deg, #fff8f6 0%, #fdeef1 55%, #fce3ea 100%);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(26, 26, 26, 0.12);

    opacity: 0;
    transform: translateY(30px);
    filter: blur(3px);
    transition: opacity 0.7s cubic-bezier(.2,.8,.2,1),
                transform 0.7s cubic-bezier(.2,.8,.2,1),
                filter 0.7s ease;
}

.ad-banner-card.in-view {
    opacity: 1;
    transform: translateY(0);
    filter: none;
}

.ad-banner-card.is-dismissed {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
}

.ad-banner-dismiss {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: rgba(26, 26, 26, 0.35);
    color: #fff;
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: background 0.25s ease, transform 0.25s ease;
}

.ad-banner-dismiss:hover {
    background: var(--accent-color, #f43f5e);
    transform: rotate(90deg);
}

.ad-banner-media {
    position: relative;
    aspect-ratio: 1600 / 320;
    overflow: hidden;
    background: linear-gradient(135deg, #f0e3e6, #e8d5da);
}

.ad-banner-media img,
.ad-banner-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ad-banner-card:hover .ad-banner-media img,
.ad-banner-card:hover .ad-banner-media video {
    transform: scale(1.05);
}

.ad-banner-media-img {
    opacity: 0;
    z-index: 1;
    transition: opacity 1s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ad-banner-media-img.is-active {
    opacity: 1;
    z-index: 2;
}

.ad-banner-media-img[data-broken="true"] {
    display: none !important;
}

.ad-banner-media-fallback {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 20px;
    color: var(--accent-color, #f43f5e);
}

.ad-banner-media.is-empty .ad-banner-media-fallback {
