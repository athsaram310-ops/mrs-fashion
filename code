}

@media (max-width: 900px) {
.ad-banner-card {
        grid-template-columns: 1fr;
    }
}

/* Fullscreen Video */
.fullscreen-video-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    padding: 60px 0;
    overflow: hidden;
    background: #000;
}

.fullscreen-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
