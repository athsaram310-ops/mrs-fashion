/* VIP Order */
.vip-order-btn {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 500;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--accent-color, #f43f5e);
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.42);
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.2s ease, border-color 0.25s ease;
    overflow: hidden;
}

.vip-order-btn img {
    width: 76%;
    height: 76%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.vip-order-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 16px 38px rgba(15, 23, 42, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.52);
    border-color: rgba(255, 255, 255, 0.6);
}

.vip-order-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
}

.vip-order-btn::after {
    content: 'VIP Order';
    position: absolute;
    left: calc(100% + 14px);
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
    background: rgba(15, 23, 42, 0.92);
    color: #fff;
    padding: 7px 14px;
    border-radius: 8px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.25);
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.vip-order-btn:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}

.vip-modal {
    position: fixed;
    inset: 0;
    z-index: 40500;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.vip-modal.active {
    display: flex;
    animation: vipBackdropIn 0.45s ease-out;
}

.vip-modal-content {
