    letter-spacing: 0.02em;
    color: #ffffff;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
}

.category-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
