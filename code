    function initShop(config) {
        const overlay = buildOverlay(config);
        const loading = overlay.querySelector('.shop-loading');
        const fill = overlay.querySelector('.shop-loading-bar-fill');
        const page = overlay.querySelector('.shop-page');
        const grid = overlay.querySelector('.shop-products-grid');
        const closeBtn = overlay.querySelector('.shop-close');
        const homeLink = overlay.querySelector('.shop-breadcrumb-home');
        const cartIcon = overlay.querySelector('.shop-cart-icon');
        const cartCountEl = cartIcon.querySelector('.cart-count');
        const viewBtns = overlay.querySelectorAll('.shop-view-btn');
        const sizeBtns = overlay.querySelectorAll('.shop-size-btn');
        const catList = overlay.querySelector('.shop-cat-list');
        let loadTimer = null;

        function renderProducts() {
            grid.innerHTML = config.products.map((p, idx) => cardHTML(p, idx)).join('');
        }
        renderProducts();

        function syncCartCount() {
            const cart = window.mrsFashionCart;
            if (cart) cartCountEl.textContent = cart.items.reduce((sum, item) => sum + item.quantity, 0);
        }
        syncCartCount();

        viewBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                viewBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                grid.className = 'products-grid shop-products-grid cols-' + btn.dataset.cols;
            });
        });

        sizeBtns.forEach(btn => {
            btn.addEventListener('click', () => btn.classList.toggle('active'));
        });

        grid.addEventListener('click', (e) => {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;
            e.preventDefault();
            const id = parseInt(btn.getAttribute('data-id'), 10);
            const product = config.products.find(p => p.id === id);
            if (product && window.mrsFashionCart) {
                const card = btn.closest('.product-card');
                const sizeChoice = resolveSizeForCard(card, product);
                if (!sizeChoice.ok) return;
                const selectedColor = product.colorOptions ? getSelectedColorForCard(card) : null;
                const selectedImage = selectedColor ? getSelectedImageForCard(card) : null;
                const cartProduct = selectedColor
                    ? { ...product, color: selectedColor, image: selectedImage || product.img }
                    : { ...product };
                if (sizeChoice.size) cartProduct.size = sizeChoice.size;
                window.mrsFashionCart.addItem(cartProduct);
                syncCartCount();
            }
        });

        cartIcon.addEventListener('click', () => {
            if (window.mrsFashionCartModal) window.mrsFashionCartModal.openCart();
        });

        function close() {
            clearTimeout(loadTimer);
            overlay.classList.remove('open');
            document.documentElement.style.overflow = '';
        }
        closeBtn.addEventListener('click', close);

        function followCategoryLink(link) {
            const [type, target] = link.split(':');
            if (type === 'shop') {
                const dest = shopRegistry[target];
                if (!dest || target === config.catKey) return;
                close();
                dest.open({ instant: true });
            } else if (type === 'section') {
                close();
                requestAnimationFrame(() => scrollToHomeSection(target));
            }
        }
        catList.addEventListener('click', (e) => {
            const item = e.target.closest('li[data-cat-link]');
            if (item) followCategoryLink(item.dataset.catLink);
        });
        catList.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const item = e.target.closest('li[data-cat-link]');
            if (!item) return;
            e.preventDefault();
            followCategoryLink(item.dataset.catLink);
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });

        homeLink.addEventListener('click', (e) => {
            e.preventDefault();
            close();
            const homeSection = document.getElementById('home');
            if (homeSection) homeSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        document.querySelectorAll('.nav-links a[href^="#"]').forEach(link => {
            link.addEventListener('click', () => {
                if (overlay.classList.contains('open')) close();
            });
        });

        function open(opts) {
            const instant = !!(opts && opts.instant);
            clearTimeout(loadTimer);
            overlay.classList.add('open');
            document.documentElement.style.overflow = 'hidden';
            overlay.scrollTop = 0;

            if (instant) {
                loading.style.display = 'none';
                page.classList.add('show');
                syncCartCount();
                return;
            }

            loading.style.display = 'flex';
            page.classList.remove('show');
            fill.style.width = '0%';

            requestAnimationFrame(() => { fill.style.width = '100%'; });

            loadTimer = setTimeout(() => {
                loading.style.display = 'none';
                page.classList.add('show');
                syncCartCount();
            }, LOAD_MS);
        }

        shopRegistry[config.catKey] = { open, close };

        const trigger = document.querySelector(config.triggerSelector);
        if (trigger) {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                open();
            });
        }

        document.querySelectorAll(`[data-shop-category="${config.catKey}"]`).forEach(navTrigger => {
            navTrigger.addEventListener('click', (e) => {
                e.preventDefault();
                open();
            });
        });

        return { open, syncCartCount };
    }

    document.addEventListener('DOMContentLoaded', () => {
        initShop({
            catKey: 'men',
            categoryLabel: 'Men',
            sidebarLabel: 'Men',
            products: menProducts,
            triggerSelector: '.category-mens'
        });
        initShop({
            catKey: 'women',
