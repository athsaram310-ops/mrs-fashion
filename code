        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            if (chooser.classList.contains('open')) closeOverlay(chooser);
            if (repay.classList.contains('open')) closeOverlay(repay);
        });

        const views = ['scrViewLookup', 'scrViewLoan', 'scrViewDone'];
        function showView(id) {
            views.forEach(v => $(v).classList.toggle('show', v === id));
            repay.querySelector('.sc-modal').scrollTop = 0;
        }

        repay.querySelectorAll('.sc-back').forEach(btn => btn.addEventListener('click', () => {
            if (btn.dataset.back === 'chooser') openChooser();
            else { resetLookup(); showView('scrViewLookup'); }
        }));

        const refInput = $('scrRef'), nicInput = $('scrNic'), lookupMsg = $('scrLookupMsg');

        function resetLookup() {
            refInput.value = ''; nicInput.value = '';
            lookupMsg.textContent = ''; lookupMsg.className = 'scr-lookup-msg';
            refInput.classList.remove('has-error'); nicInput.classList.remove('has-error');
            currentRef = null;
        }
        nicInput.addEventListener('input', () => {
            nicInput.value = nicInput.value.replace(/[^\dvVxX]/g, '').slice(0, 12);
            nicInput.classList.remove('has-error'); lookupMsg.textContent = '';
        });
        refInput.addEventListener('input', () => { refInput.classList.remove('has-error'); lookupMsg.textContent = ''; });

        function lookupMessage(text, kind) {
            lookupMsg.textContent = text;
            lookupMsg.className = 'scr-lookup-msg ' + (kind || 'err');
        }

        $('scrLookupForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const ref = refInput.value.trim(), nic = nicInput.value.trim();
            const refBad = ref.length < 3;
            const nicBad = !/^(\d{9}[vVxX]|\d{12})$/.test(nic);
            refInput.classList.toggle('has-error', refBad);
            nicInput.classList.toggle('has-error', nicBad);
            if (refBad || nicBad) { lookupMessage('Enter your loan reference and a valid NIC number.'); (refBad ? refInput : nicInput).focus(); return; }

            const loan = findLoan(ref, nic);
            if (loan) { openLoan(loan.reference); return; }

            const pending = loadApplications().find(a =>
                a.reference.toUpperCase() === ref.toUpperCase() && a.nic.toLowerCase() === nic.toLowerCase());
            if (pending) {
                lookupMessage('Your application is still under review. You can make repayments once it has been approved and the credit has been released.', 'info');
            } else {
                lookupMessage('We could not find a loan with those details. Check your reference number and NIC and try again.');
            }
        });

        let currentRef = null;
        let option = 'next';
        let method = 'card';

        function currentLoan() { return loadLoans().find(l => l.reference === currentRef) || null; }

        function openLoan(ref) {
            currentRef = ref;
            option = 'next'; method = 'card';
            repay.querySelectorAll('#scrOptions .scr-option').forEach(o => {
