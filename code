    getPageItems() {
        const start = (this.currentPage - 1) * this.itemsPerPage;
        return this.products.slice(start, start + this.itemsPerPage);
    }

    renderStars(rating) {
        const full = Math.floor(rating);
        const hasHalf = rating - full >= 0.5;
        let html = '';
        for (let s = 0; s < full; s++) html += '<i class="fas fa-star"></i>';
        if (hasHalf) html += '<i class="fas fa-star-half-alt"></i>';
        const remaining = 5 - full - (hasHalf ? 1 : 0);
        for (let s = 0; s < remaining; s++) html += '<i class="far fa-star"></i>';
        return html;
    }

    colorSwatchesHTML(product) {
        if (!product.colorOptions || !product.colorOptions.length) return '';
        return `
            <div class="product-colors">
                ${product.colorOptions.map((opt, idx) => `
                    <button
                        type="button"
                        class="color-swatch${idx === 0 ? ' active' : ''}"
                        style="background-color:${opt.color}"
                        data-color="${opt.color}"
                        aria-label="View in ${opt.color}"
                        onclick="swapProductImage(this, '${opt.image}')"
                    ></button>
                `).join('')}
            </div>
        `;
    }

    cardHTML(product, indexOnPage) {
        const badgeHTML = product.badge
            ? `<div class="product-badge${product.badge === 'hot' ? ' hot' : ''}${product.badge === 'sale' ? ' sale' : ''}">${product.badge === 'hot' ? 'Hot' : product.badge === 'sale' ? 'Sale' : product.badge}</div>`
            : '';

        return `
            <div class="product-card" data-id="${product.id}" style="animation-delay:${0.06 * indexOnPage}s">
                <div class="product-image">
                    <img
                        src="${product.image}"
                        alt="${product.name}"
                        loading="lazy"
                        data-fallback="${product.fallback}"
                        onerror="
                            if(this.src !== this.dataset.fallback){
                                this.src = this.dataset.fallback;
                            }
                        "
                    >
                    ${badgeHTML}
                    <div class="product-overlay">
                        <button class="btn btn-small quick-view-btn" data-id="${product.id}">Quick View</button>
                    </div>
                </div>
                <div class="product-info">
                    <h3>${product.name}</h3>
                    <div class="product-rating">${this.renderStars(product.rating)}</div>
                    <div class="product-price">
                        <span class="price">LKR ${product.price.toLocaleString()}</span>
                        <span class="original-price">LKR ${product.originalPrice.toLocaleString()}</span>
                    </div>
                    ${this.colorSwatchesHTML(product)}
                    <button class="btn btn-outline btn-full add-to-cart-btn" data-id="${product.id}">Add to Cart</button>
                </div>
            </div>
        `;
    }

    render() {
        if (!this.grid) return;
        const items = this.getPageItems();
        this.grid.innerHTML = items.map((p, idx) => this.cardHTML(p, idx)).join('');
        this.renderPagination();
        this.attachCardTilt();
    }

    renderPagination() {
        if (!this.paginationEl) return;
        let html = `<button class="page-btn page-nav" data-action="prev" ${this.currentPage === 1 ? 'disabled' : ''} aria-label="Previous page"><i class="fas fa-chevron-left"></i></button>`;
        for (let p = 1; p <= this.totalPages; p++) {
            html += `<button class="page-btn${p === this.currentPage ? ' active' : ''}" data-page="${p}">${p}</button>`;
        }
        html += `<button class="page-btn page-nav" data-action="next" ${this.currentPage === this.totalPages ? 'disabled' : ''} aria-label="Next page"><i class="fas fa-chevron-right"></i></button>`;
        this.paginationEl.innerHTML = html;
    }

    goToPage(page) {
        if (page < 1 || page > this.totalPages || page === this.currentPage) return;
        this.currentPage = page;
        if (this.grid) this.grid.classList.add('paging');
        this.render();
        const collectionsSection = document.getElementById('collections');
        if (collectionsSection) collectionsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    attachDelegatedEvents() {
        if (this.grid) {
            this.grid.addEventListener('click', (e) => {
                const addBtn = e.target.closest('.add-to-cart-btn');
                if (addBtn) {
                    e.preventDefault();
                    const product = this.products.find(p => p.id === parseInt(addBtn.getAttribute('data-id')));
                    if (product) {
                        const card = addBtn.closest('.product-card');
                        const selectedColor = product.colorOptions ? getSelectedColorForCard(card) : null;
                        const selectedImage = selectedColor ? getSelectedImageForCard(card) : null;
                        this.cart.addItem(selectedColor
                            ? { ...product, color: selectedColor, image: selectedImage || product.image }
                            : product);
                    }
                    return;
                }
                const quickBtn = e.target.closest('.quick-view-btn');
                if (quickBtn) {
                    e.preventDefault();
                    const product = this.products.find(p => p.id === parseInt(quickBtn.getAttribute('data-id')));
                    if (product) this.showQuickView(product);
                    return;
                }

                if (e.target.closest('.color-swatch')) return;

                const imageArea = e.target.closest('.product-image');
                if (imageArea) {
                    const card = imageArea.closest('.product-card');
                    if (card) {
                        const alreadyOpen = card.classList.contains('show-overlay');
                        this.grid.querySelectorAll('.product-card.show-overlay').forEach(c => c.classList.remove('show-overlay'));
                        if (!alreadyOpen) card.classList.add('show-overlay');
                    }
                }
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.product-card')) {
                    this.grid.querySelectorAll('.product-card.show-overlay').forEach(c => c.classList.remove('show-overlay'));
                }
            });
        }
        if (this.paginationEl) {
            this.paginationEl.addEventListener('click', (e) => {
                const btn = e.target.closest('.page-btn');
                if (!btn || btn.disabled) return;
                if (btn.dataset.action === 'prev')      this.goToPage(this.currentPage - 1);
                else if (btn.dataset.action === 'next') this.goToPage(this.currentPage + 1);
                else if (btn.dataset.page)              this.goToPage(parseInt(btn.dataset.page));
            });
        }
    }

    attachCardTilt() {
        document.querySelectorAll('.product-card').forEach(card => {
            const maxTilt = 7;
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const px = (e.clientX - rect.left) / rect.width;
                const py = (e.clientY - rect.top) / rect.height;
                card.style.transform = `translateY(-10px) rotateX(${(0.5 - py) * maxTilt * 2}deg) rotateY(${(px - 0.5) * maxTilt * 2}deg)`;
            });
            card.addEventListener('mouseleave', () => { card.style.transform = ''; });
        });
    }

    showQuickView(product) {
        const modal = document.createElement('div');
        modal.className = 'quick-view-overlay';
        modal.innerHTML = `
            <div class="quick-view-dialog">
                <button class="quick-view-close">×</button>
                <img
                    src="${product.image}"
                    alt="${product.name}"
                    class="quick-view-img"
                    data-fallback="${product.fallback}"
                    onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback;}"
                >
                <h2 class="quick-view-title">${product.name}</h2>
                <div class="quick-view-stars">${this.renderStars(product.rating)}</div>
                <p class="quick-view-desc">
                    A premium ${product.category.toLowerCase()} piece crafted with the finest materials.
                    Perfect for any occasion — combining style with comfort.
                </p>
                <p class="quick-view-price">
                    LKR ${product.price.toLocaleString()}
                    <span class="quick-view-original-price">
                        LKR ${product.originalPrice.toLocaleString()}
                    </span>
                </p>
                <div class="quick-view-actions">
                    <button class="quick-view-add">
                        Add to Cart
                    </button>
                    <button class="quick-view-wishlist">
                        Add to Wishlist
                    </button>
                </div>
            </div>
        `;

        document.body.appendChild(modal);
        modal.querySelector('.quick-view-close').addEventListener('click', () => modal.remove());
        modal.querySelector('.quick-view-add').addEventListener('click', () => {
            this.cart.addItem(product);
            modal.remove();
        });
        modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
    }
}

// Smooth Scrolling
class SmoothScroller {
    constructor() {
        document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const target = document.querySelector(link.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    }
}

// Scroll Animations
class ScrollAnimations {
    constructor() {
        const observer = new IntersectionObserver(
            (entries) => entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.animation = 'slideUp 0.6s ease-out forwards';
