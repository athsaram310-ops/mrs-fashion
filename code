/* Live Chat */
.live-chat-btn {
    position: fixed;
    left: 24px;
    bottom: 90px;
    z-index: 500;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--accent-color, #f43f5e);
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.42);
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.2s ease, border-color 0.25s ease;
    overflow: hidden;
}

.live-chat-btn img {
    width: 76%;
    height: 76%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.live-chat-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 16px 38px rgba(15, 23, 42, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.52);
    border-color: rgba(255, 255, 255, 0.6);
}

.live-chat-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
}

.live-chat-btn::after {
    content: 'Live Chat';
    position: absolute;
    left: calc(100% + 14px);
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
    background: rgba(15, 23, 42, 0.92);
    color: #fff;
    padding: 7px 14px;
    border-radius: 8px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.25);
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.live-chat-btn:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}

.live-chat-window {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 40600;
    width: min(320px, calc(100vw - 48px));
    height: 420px;
    max-height: calc(100vh - 48px);
    background: #a5a3a36f;
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.32);
    display: none;
    flex-direction: column;
    overflow: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition: opacity 0.25s ease, transform 0.25s ease;
}

.live-chat-window.open { display: flex; }

.live-chat-window.show {
    opacity: 1;
    transform: translateY(0) scale(1);
}

.live-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #ffffff86;
    flex-shrink: 0;
}

.live-chat-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 800;
}

.live-chat-header-title i { color: var(--accent-color, #f43f5e); }

.live-chat-close {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, transform 0.3s ease;
}

.live-chat-close:hover {
    background: var(--accent-color, #f43f5e);
    transform: rotate(90deg);
}

.live-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f9fafb76;
}

.live-chat-msg {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13.5px;
    line-height: 1.5;
    animation: liveChatMsgIn 0.3s ease-out;
    word-wrap: break-word;
}

.live-chat-msg.agent {
    align-self: flex-start;
    background: #ffffff77;
    color: var(--text-dark, #1e293b);
    border-bottom-left-radius: 4px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.live-chat-msg.user {
    align-self: flex-end;
    background: var(--primary-color, #1a1a1a);
    color: #ffffff82;
    border-bottom-right-radius: 4px;
}

@keyframes liveChatMsgIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}

.live-chat-input-row {
    flex-shrink: 0;
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #eee;
    background: #ffffffa3;
}

.live-chat-input-row input {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    border: 1.5px solid #e2e2e2;
    border-radius: 50px;
    font-size: 13.5px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
}

.live-chat-input-row input:focus { border-color: var(--primary-color, #1a1a1a); }

.live-chat-send-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
}

.live-chat-send-btn:hover { transform: translateY(-2px); }

@media (max-width: 560px) {
.live-chat-btn { left: 16px; bottom: 82px; width: 48px; height: 48px; }
.live-chat-btn i { font-size: 20px; }
.live-chat-window { left: 16px; bottom: 16px; width: calc(100vw - 32px); }
}

@media (prefers-reduced-motion: reduce) {
.live-chat-btn:hover { transform: none; }
.live-chat-window { transition: none !important; }
.live-chat-msg { animation: none !important; }
}

