.checkout-confirm h2 { font-size: clamp(20px, 3vw, 26px); font-weight: 800; margin-bottom: 10px; color: var(--text-dark, #1e293b); }

.checkout-confirm p { font-size: 14.5px; color: var(--text-light, #64748b); max-width: 380px; line-height: 1.6; margin-bottom: 26px; }

.checkout-confirm-order {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-dark, #1e293b);
