        };
    }

    function loadLoans() {
        try {
            const raw = localStorage.getItem(REPAY_CONFIG.loansKey);
            if (raw) return JSON.parse(raw);
        } catch (e) {  }
        const seeded = [demoLoan()];
        saveLoans(seeded);
        return seeded;
    }
    function saveLoans(list) {
        try { localStorage.setItem(REPAY_CONFIG.loansKey, JSON.stringify(list)); } catch (e) {  }
    }
    function loadApplications() {
        try { return JSON.parse(localStorage.getItem(REPAY_CONFIG.applicationsKey) || '[]'); } catch (e) { return []; }
    }
    function findLoan(ref, nic) {
        const R = ref.trim().toUpperCase(), N = nic.trim().toLowerCase();
        return loadLoans().find(l => l.reference.toUpperCase() === R && l.nic.toLowerCase() === N) || null;
    }
    function updateLoan(loan) {
        const list = loadLoans();
        const i = list.findIndex(l => l.reference === loan.reference);
        if (i >= 0) list[i] = loan; else list.push(loan);
        saveLoans(list);
    }

    function approveLoan(reference) {
        const app = loadApplications().find(a => a.reference === reference);
        if (!app) return false;
        const loans = loadLoans();
        if (loans.some(l => l.reference === reference)) return false;
        loans.push({
            reference: app.reference, nic: app.nic, borrowerName: app.borrowerName,
            amount: app.amount, months: app.installments, monthlyRatePct: app.monthlyRatePct,
            monthly: app.monthlyInstallment, disbursedAt: new Date().toISOString(),
            paidCount: 0, settled: false, payments: [],
        });
        saveLoans(loans);
        return true;
    }

    function buildSchedule(loan) {
        const r = loan.monthlyRatePct / 100;
        const today = startOfDay(new Date());
        const base = startOfDay(loan.disbursedAt);
        let bal = loan.amount;
        const rows = [];
        for (let k = 1; k <= loan.months; k++) {
            const interest = Math.round(bal * r);
            const principal = Math.min(bal, loan.monthly - interest);
            bal = Math.max(0, bal - principal);
            const due = addMonths(base, k);
            let status;
            if (k <= loan.paidCount) status = 'paid';
            else if (due < today) status = 'overdue';
            else if (due.getTime() === today.getTime()) status = 'today';
            else status = 'upcoming';
            rows.push({ n: k, due, amount: loan.monthly, interest, principal, balanceAfter: bal, status });
        }
        return rows;
    }

    function getQuote(loan, option, aheadCount) {
        const rows = buildSchedule(loan);
        const p = loan.paidCount;
        const remaining = loan.months - p;
        if (remaining <= 0) return { rows, count: 0, base: 0, lateFee: 0, total: 0, label: '' };

        let count, base, label;
        if (option === 'settle') {
            count = remaining;
            const bal = p === 0 ? loan.amount : rows[p - 1].balanceAfter;
            const interest = Math.round(bal * (loan.monthlyRatePct / 100) * REPAY_CONFIG.settlementInterestMonths);
            base = bal + interest;
            label = 'Early settlement';
        } else {
            count = option === 'ahead' ? Math.min(Math.max(2, aheadCount), remaining) : 1;
            base = count * loan.monthly;
            label = count === 1 ? 'Next installment' : `${count} installments`;
        }
        const overdue = rows.slice(p, p + count).filter(r => r.status === 'overdue').length;
        const lateFee = overdue * REPAY_CONFIG.lateFeeLKR;
        return { rows, count, base, lateFee, overdue, total: base + lateFee, label };
    }

