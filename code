        function refreshPayButtonState() {
            const cart = window.mrsFashionCart;
            const subtotal = cart ? cart.getTotalPrice() : 0;
            const activeMethod = currentPaymentMethod();
            const insufficient = activeMethod === 'ewallet' ? renderEwalletState(currentGrandTotal) : false;
            payBtn.disabled = subtotal <= 0 || insufficient;
        }

        function syncCardDetailsVisibility() {
            const activeMethod = currentPaymentMethod();

            Object.keys(PAYMENT_DETAIL_PANELS).forEach(method => {
                const panel = PAYMENT_DETAIL_PANELS[method];
                if (!panel) return;
                panel.classList.toggle('show', method === activeMethod);
            });

            if (activeMethod !== 'card') {
                [cardNameField, cardNumberField, cardExpiryField, cardCvvField].forEach(f => {
                    if (f) f.classList.remove('has-error');
                });
