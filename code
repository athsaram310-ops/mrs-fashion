}

.hero-subtitle {
    opacity: 0;
    animation: heroRise 0.49s 0.55s cubic-bezier(.2,.8,.2,1) forwards;
}

.hero-content .nav-link2 {
    display: inline-block;
    opacity: 0;
    animation: heroRise 0.55s 0.65s cubic-bezier(.2,.8,.2,1) forwards;
}

@keyframes heroRise {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
}

.scroll-cue {
    position: absolute;
    bottom: 36px;
    left: 48%;
    transform: translateX(-50%);
    z-index: 5;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-light);
