    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
}

.limited-edition .section-header h2::after { background: #fff; }

.limited-edition .section-header p {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
}

.le-see-more {
