// Scroll Background
class ScrollBackground {
    constructor() {
        this.stops = [
            { selector: '#home',        bg: '#ffffff' },
            { selector: '#collections', bg: 'linear-gradient(160deg, #fdf6f9 0%, #fff1f3 100%)' },
            { selector: '.features',    bg: 'linear-gradient(160deg, #f5f5f5 0%, #e8e8e8 100%)' },
            { selector: '#about',       bg: 'linear-gradient(160deg, #f0f4ff 0%, #e8f0fe 100%)' },
            { selector: '#contact',     bg: 'linear-gradient(160deg, #f9fafb 0%, #f3f4f6 100%)' },
        ];

        this.bg = document.createElement('div');
        this.bg.id = 'scroll-bg';
        document.body.prepend(this.bg);

        this._setup();
    }

    _setup() {
        const io = new IntersectionObserver(
            (entries) => {
                let best = null;
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const stop = this.stops.find(s => entry.target.matches(s.selector));
                        if (stop) best = stop;
                    }
                });
                if (best) this.bg.style.background = best.bg;
            },
            {
                threshold: 0.25,
                rootMargin: '0px 0px -20% 0px'
            }
        );

        this.stops.forEach(stop => {
            const el = document.querySelector(stop.selector);
            if (el) io.observe(el);
        });
    }
}

