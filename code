                shippingPlaceholder.style.display = '';
                shippingOptions.style.display = 'none';
            }
            updateTotals();
        }

        shippingOptions.addEventListener('click', (e) => {
            const opt = e.target.closest('.checkout-shipping-option');
            if (!opt) return;
            shippingOptions.querySelectorAll('.checkout-shipping-option').forEach(o => o.classList.remove('selected'));
            opt.classList.add('selected');
            opt.querySelector('input').checked = true;
            selectedShippingFee = parseInt(opt.dataset.fee, 10) || 0;
            updateTotals();
        });

        payList.addEventListener('click', (e) => {
            const opt = e.target.closest('.checkout-pay-option');
            if (!opt || opt.classList.contains('pay-option-hidden')) return;
            payList.querySelectorAll('.checkout-pay-option').forEach(o => o.classList.remove('selected'));
