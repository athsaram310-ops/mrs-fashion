        t.setDate(Math.min(day, last));
        return t;
    }
    const fmtDate = (d) => new Date(d).toLocaleDateString('en-LK', { day: 'numeric', month: 'short', year: 'numeric' });

    function calcMonthly(principal, months, ratePct) {
        const r = ratePct / 100;
        const emi = r === 0 ? principal / months
            : (principal * r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1);
        return Math.ceil(emi);
    }

