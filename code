        chooser.addEventListener('click', (e) => { if (e.target === chooser) closeOverlay(chooser); });
        chooser.querySelectorAll('.scc-card').forEach(card => card.addEventListener('click', () => {
            if (card.dataset.choice === 'apply') {
                closeOverlay(chooser);
                if (api.openApply) api.openApply();
