            sidebarLabel: 'Office',
            products: officeProducts,
            triggerSelector: '.category-office'
        });
        initShop({
            catKey: 'school',
            categoryLabel: 'School',
            sidebarLabel: 'School',
            products: schoolProducts,
            triggerSelector: '.category-school'
        });
        initShop({
            catKey: 'homeLifestyle',
            categoryLabel: 'Home & Lifestyle',
            sidebarLabel: 'Home & Lifestyle',
            products: homeProducts,
            triggerSelector: '.category-homelifestyle'
        });
        initShop({
            catKey: 'toysGames',
            categoryLabel: 'Toys & Games',
            sidebarLabel: 'Toys & Games',
            products: toysGamesProducts,
            triggerSelector: '.category-toysgames'
        });
    });
})();

