// Search
(function () {
    'use strict';

    const DEBOUNCE_MS = 160;
    const MAX_RESULTS = 8;
    const QUICK_LINKS = ['Bags', 'Shoes', 'Wallets', 'Umbrellas'];

    document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('searchBar');
        if (!overlay) return;

        const input = document.getElementById('searchInput');
        const closeBtn = overlay.querySelector('.search-close');
        const resultsEl = document.getElementById('searchResults');
        const searchTrigger = document.querySelector('.search-icon');

        let activeIndex = -1;
        let debounceTimer = null;

        function getProducts() {
            const pm = window.mrsFashionProductManager;
            return pm ? pm.products : [];
        }

        function escapeHTML(str) {
            return String(str).replace(/[&<>"']/g, (s) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[s]));
        }

        function highlightMatch(name, q) {
            const safeName = escapeHTML(name);
            if (!q) return safeName;
            const idx = name.toLowerCase().indexOf(q.toLowerCase());
            if (idx === -1) return safeName;
            return escapeHTML(name.slice(0, idx)) +
                '<mark>' + escapeHTML(name.slice(idx, idx + q.length)) + '</mark>' +
                escapeHTML(name.slice(idx + q.length));
        }

        function renderIdle() {
            resultsEl.innerHTML = `
                <div class="search-hint">
                    <i class="fas fa-search"></i>
                    <p>Start typing to search products…</p>
                    <div class="search-quick-links">
                        ${QUICK_LINKS.map(l => `<button type="button" data-quick="${l}">${l}</button>`).join('')}
                    </div>
                </div>`;
        }

        function renderNoResults(q) {
            resultsEl.innerHTML = `
                <div class="search-empty">
                    <i class="fas fa-face-frown"></i>
                    <p>No products found for &ldquo;<strong>${escapeHTML(q)}</strong>&rdquo;</p>
                    <span>Try a different keyword or check your spelling.</span>
                </div>`;
        }

        function renderResults(results, q) {
            activeIndex = -1;
            resultsEl.innerHTML = results.map((p, i) => `
                <div class="search-result-item" data-id="${p.id}" data-index="${i}" style="animation-delay:${i * 0.03}s">
                    <div class="search-result-thumb">
                        <img
                            src="${p.image}"
                            alt="${escapeHTML(p.name)}"
                            loading="lazy"
                            data-fallback="${p.fallback || 'Product Images'}"
                            onerror="if(this.src !== this.dataset.fallback){ this.src = this.dataset.fallback; }">
                    </div>
                    <div class="search-result-info">
                        <h4>${highlightMatch(p.name, q)}</h4>
                        <div class="search-result-price">
                            <span class="price">LKR ${p.price.toLocaleString()}</span>
                            <span class="original-price">LKR ${p.originalPrice.toLocaleString()}</span>
                        </div>
                    </div>
                    <button type="button" class="search-result-add" data-id="${p.id}" aria-label="Add to cart">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            `).join('') + (results.length >= MAX_RESULTS
                ? `<div class="search-more-hint">Showing top ${MAX_RESULTS} matches — refine your search for more.</div>`
                : '');
        }

        function performSearch(rawQuery) {
            const q = rawQuery.trim();
            if (!q) { renderIdle(); return; }
            const lower = q.toLowerCase();
            const results = getProducts()
                .filter(p => p.name.toLowerCase().includes(lower))
                .slice(0, MAX_RESULTS);
            if (!results.length) { renderNoResults(q); return; }
            renderResults(results, q);
        }

        function open() {
            overlay.classList.add('active');
            document.documentElement.style.overflow = 'hidden';
            renderIdle();
            setTimeout(() => input.focus(), 60);
        }

        function close() {
            overlay.classList.remove('active');
            document.documentElement.style.overflow = '';
            input.value = '';
            activeIndex = -1;
        }

        if (searchTrigger) {
            searchTrigger.addEventListener('click', (e) => { e.preventDefault(); open(); });
        }
        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && overlay.classList.contains('active')) close();
        });

        input.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            const val = e.target.value;
            debounceTimer = setTimeout(() => performSearch(val), DEBOUNCE_MS);
        });

        function goToProduct(id) {
            const pm = window.mrsFashionProductManager;
            if (!pm) { close(); return; }
            const idx = pm.products.findIndex(p => p.id === id);
            if (idx === -1) { close(); return; }
            const page = Math.floor(idx / pm.itemsPerPage) + 1;
            close();
            pm.goToPage(page);
            setTimeout(() => {
                const card = document.querySelector(`#productsGrid .product-card[data-id="${id}"]`);
                if (card) {
                    card.classList.add('search-highlight');
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => card.classList.remove('search-highlight'), 1800);
                }
            }, 120);
        }

        resultsEl.addEventListener('click', (e) => {
            const quick = e.target.closest('[data-quick]');
            if (quick) {
                input.value = quick.getAttribute('data-quick');
                performSearch(input.value);
                input.focus();
                return;
            }

            const addBtn = e.target.closest('.search-result-add');
            if (addBtn) {
                e.stopPropagation();
                const id = parseInt(addBtn.getAttribute('data-id'), 10);
                const product = getProducts().find(p => p.id === id);
                if (product && window.mrsFashionCart) {
                    window.mrsFashionCart.addItem(product);
                    const icon = addBtn.querySelector('i');
                    addBtn.classList.add('added');
                    if (icon) { icon.classList.remove('fa-plus'); icon.classList.add('fa-check'); }
                    setTimeout(() => {
                        addBtn.classList.remove('added');
                        if (icon) { icon.classList.remove('fa-check'); icon.classList.add('fa-plus'); }
                    }, 900);
                }
                return;
            }

            const row = e.target.closest('.search-result-item');
            if (row) goToProduct(parseInt(row.getAttribute('data-id'), 10));
        });

        input.addEventListener('keydown', (e) => {
            const items = Array.from(resultsEl.querySelectorAll('.search-result-item'));
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = Math.min(activeIndex + 1, items.length - 1);
                updateActive(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = Math.max(activeIndex - 1, 0);
                updateActive(items);
            } else if (e.key === 'Enter' && activeIndex >= 0 && items[activeIndex]) {
                e.preventDefault();
                goToProduct(parseInt(items[activeIndex].getAttribute('data-id'), 10));
            }
        });

        function updateActive(items) {
            items.forEach((it, i) => it.classList.toggle('is-active', i === activeIndex));
            if (items[activeIndex]) items[activeIndex].scrollIntoView({ block: 'nearest' });
        }
    });
})();

// Cursor Glow & Page Effects
document.addEventListener('DOMContentLoaded', () => {

    const glow = document.getElementById('cursorGlow');
    if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let gx = window.innerWidth / 2, gy = window.innerHeight / 2;
        let tx = gx, ty = gy;
        window.addEventListener('mousemove', (e) => {
            tx = e.clientX; ty = e.clientY;
            glow.classList.add('active');
        });
        window.addEventListener('mouseleave', () => glow.classList.remove('active'));
        (function loop() {
            gx += (tx - gx) * 0.12;
            gy += (ty - gy) * 0.12;
            glow.style.transform = `translate(${gx}px, ${gy}px) translate(-50%, -50%)`;
            requestAnimationFrame(loop);
        })();
    }

    document.querySelectorAll('.product-card').forEach(card => {
        const maxTilt = 7;
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width;
            const py = (e.clientY - rect.top) / rect.height;
            const rotateY = (px - 0.5) * maxTilt * 2;
            const rotateX = (0.5 - py) * maxTilt * 2;
            card.style.transform = `translateY(-10px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });
        card.addEventListener('mouseleave', () => {
            card.style.transform = '';
        });
    });

    const statNumbers = document.querySelectorAll('.stat-number[data-count]');
    const animateCount = (el) => {
        const target = parseFloat(el.getAttribute('data-count'));
        const suffix = el.getAttribute('data-suffix') || '';
        const duration = 1400;
        const start = performance.now();
        function tick(now) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
    };

    if (statNumbers.length) {
        const statObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCount(entry.target);
                    statObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.4 });
        statNumbers.forEach(el => statObserver.observe(el));
    }

    const revealTargets = document.querySelectorAll(
        '.section-header, .feature-item, .about-content, .contact-container'
    );
    revealTargets.forEach(el => el.classList.add('reveal'));

    document.querySelectorAll('.products-grid, .footer-content').forEach(el => {
        el.classList.add('reveal-stagger');
    });

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => revealObserver.observe(el));

    const socialButtons = document.querySelector('.social-buttons');
    if (socialButtons && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const proximity = 160;
        let hideTimeout;
        window.addEventListener('mousemove', (e) => {
            const nearRight = e.clientX > window.innerWidth - proximity;
            if (nearRight) {
                clearTimeout(hideTimeout);
                socialButtons.classList.add('visible');
            } else {
                clearTimeout(hideTimeout);
                hideTimeout = setTimeout(() => {
                    socialButtons.classList.remove('visible');
                }, 250);
            }
        });
        socialButtons.addEventListener('mouseenter', () => {
            clearTimeout(hideTimeout);
            socialButtons.classList.add('visible');
        });
        socialButtons.addEventListener('mouseleave', () => {
            hideTimeout = setTimeout(() => socialButtons.classList.remove('visible'), 250);
        });
    }

    document.querySelectorAll('.nav-icon').forEach(icon => {
        icon.addEventListener('click', () => {
            icon.classList.remove('bounce');
            void icon.offsetWidth;
            icon.classList.add('bounce');
        });
    });
});

