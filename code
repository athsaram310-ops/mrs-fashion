            media.closest('.le-card').classList.toggle('show-back');
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const section = document.getElementById('limited-edition');
        const track = document.getElementById('leTrack');
        if (!section || !track) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        track.innerHTML = CAROUSEL_ITEMS.map(cardHTML).join('');

        const prevBtn = document.getElementById('lePrev');
        const nextBtn = document.getElementById('leNext');
        const carousel = document.getElementById('leCarousel');
        let timer = null;
        let busy = false;

        function stepSize() {
            const first = track.firstElementChild;
            const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
            return first.getBoundingClientRect().width + gap;
        }

        function next() {
            if (busy || track.children.length < 2) return;
            busy = true;
            const dur = reduceMotion ? 0 : SLIDE_MS;
            track.style.transition = dur ? `transform ${dur}ms cubic-bezier(.2,.8,.2,1)` : 'none';
            track.style.transform = `translateX(-${stepSize()}px)`;
            setTimeout(() => {
                track.style.transition = 'none';
                track.appendChild(track.firstElementChild);
                track.style.transform = 'translateX(0)';
                void track.offsetWidth;
                busy = false;
            }, dur);
        }

        function prev() {
            if (busy || track.children.length < 2) return;
            busy = true;
            const dur = reduceMotion ? 0 : SLIDE_MS;
            track.style.transition = 'none';
            track.insertBefore(track.lastElementChild, track.firstElementChild);
            track.style.transform = `translateX(-${stepSize()}px)`;
            void track.offsetWidth;
            track.style.transition = dur ? `transform ${dur}ms cubic-bezier(.2,.8,.2,1)` : 'none';
            track.style.transform = 'translateX(0)';
            setTimeout(() => { busy = false; }, dur);
        }

        function start() { if (!timer) timer = setInterval(next, ROTATE_MS); }
        function stop()  { clearInterval(timer); timer = null; }
        function restart() { stop(); start(); }

        nextBtn.addEventListener('click', () => { next(); restart(); });
        prevBtn.addEventListener('click', () => { prev(); restart(); });

        carousel.addEventListener('mouseenter', stop);
        carousel.addEventListener('mouseleave', start);

        new IntersectionObserver((entries) => {
            entries.forEach(en => en.isIntersecting ? start() : stop());
        }, { threshold: 0.2 }).observe(section);

        document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    });
})();

