(function () {
    'use strict';

    const MIN_MS = 2500;
    const MAX_MS = 8000;

    const screen  = document.getElementById('loading-screen');
    const barFill = document.querySelector('.ls-bar-fill');

    if (!screen) {
        document.body.classList.remove('is-loading');
        return;
    }

    document.documentElement.style.overflow = 'hidden';

    const siteVideos = Array.from(document.querySelectorAll('video'))
        .filter(v => !screen.contains(v));
    const resumeList = [];
    const holdPlay = (e) => e.target.pause();

    siteVideos.forEach(v => {
        if (v.hasAttribute('autoplay') && !v.closest('#updates')) resumeList.push(v);
        v.removeAttribute('autoplay');
        v.autoplay = false;
        v.pause();
        v.currentTime = 0;
        v.addEventListener('play', holdPlay);
    });

    function releaseSite() {
        siteVideos.forEach(v => v.removeEventListener('play', holdPlay));
        resumeList.forEach(v => {
            v.currentTime = 0;
            const p = v.play();
            if (p !== undefined) p.catch(() => {});
        });
        document.body.classList.remove('is-loading');
        window.dispatchEvent(new Event('mrs:site-ready'));
    }

    let progress    = 0;
    let startTime   = Date.now();
    let rafId       = null;
    let dismissed   = false;

    function advanceBar() {
        if (dismissed) return;

        const elapsed  = Date.now() - startTime;
        const fraction = Math.min(elapsed / MAX_MS, 1);

        const eased = 1 - Math.pow(1 - fraction, 2.5);
        progress = Math.min(eased * 95, 95);

        if (barFill) barFill.style.width = progress + '%';

        if (progress < 95) {
            rafId = requestAnimationFrame(advanceBar);
        }
    }

    rafId = requestAnimationFrame(advanceBar);

    function dismiss() {
        if (dismissed) return;
        dismissed = true;

        cancelAnimationFrame(rafId);

        if (barFill) {
            barFill.style.transition = 'width 0.35s ease';
            barFill.style.width      = '100%';
        }

        setTimeout(() => {
            screen.classList.add('hide');
            releaseSite();

            screen.addEventListener('transitionend', () => {
                const bg = screen.querySelector('.ls-bg-video');
                if (bg) { bg.pause(); bg.removeAttribute('src'); bg.load(); }
                screen.remove();
            }, { once: true });

            document.documentElement.style.overflow = '';
        }, 350);
    }

    let pageReady = false;
    let minElapsed = false;

    function tryDismiss() {
        if (pageReady && minElapsed) dismiss();
    }

    setTimeout(() => {
        minElapsed = true;
        tryDismiss();
    }, MIN_MS);

    setTimeout(dismiss, MAX_MS);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            pageReady = true;
            tryDismiss();
        });
    } else {
        pageReady = true;
        tryDismiss();
    }

    window.addEventListener('load', () => {
        pageReady = true;
        tryDismiss();
    });
})();

