            if (e.target === modal) this.closeCart();
        });

        payBtn.addEventListener('click', () => this.handlePayment());
    }

    toggleCart() {
        this.isOpen ? this.closeCart() : this.openCart();
    }

    openCart() {
        const modal = document.getElementById('cartModal');
        modal.classList.add('active');
        this.isOpen = true;
        this.renderCartItems();
    }

    closeCart() {
        const modal = document.getElementById('cartModal');
        modal.classList.remove('active');
        this.isOpen = false;
    }

    renderCartItems() {
        const cartItemsContainer = document.getElementById('cartItems');
        const subtotalEl = document.getElementById('subtotal');
        const totalEl = document.getElementById('totalPrice');
        const discountRowEl = document.getElementById('discountRow');
        const discountLabelEl = document.getElementById('discountLabel');
        const discountAmountEl = document.getElementById('discountAmount');

                const deliveryFeeEl = document.getElementById('deliveryFee');
        if (deliveryFeeEl) {
            const fee = this.cart.getDeliveryFee();
            deliveryFeeEl.textContent = fee === 0 ? 'Free — Digital tickets' : `LKR ${fee.toLocaleString()}`;
        }

        if (this.cart.items.length === 0) {
            cartItemsContainer.innerHTML = '<div class="cart-empty"><p>Your cart is empty</p></div>';
            subtotalEl.textContent = 'LKR 0';
            if (discountRowEl) discountRowEl.style.display = 'none';
            totalEl.textContent = 'LKR 0';
            return;
        }

        cartItemsContainer.innerHTML = this.cart.items.map(item => cartItemRowHTML(item)).join('');

        bindCartItemControls(cartItemsContainer, this);

        const subtotal = this.cart.getTotalPrice();
        const discountPct = this.cart.getDiscountPercentage();
        const discountAmount = this.cart.getDiscountAmount();
        const total = this.cart.getTotalWithDelivery();

        subtotalEl.textContent = `LKR ${subtotal.toLocaleString()}`;

        if (discountRowEl) {
            if (discountPct > 0) {
                discountRowEl.style.display = 'flex';
                if (discountLabelEl) discountLabelEl.textContent = `Discount (${discountPct}%):`;
                if (discountAmountEl) discountAmountEl.textContent = `- LKR ${discountAmount.toLocaleString()}`;
            } else {
                discountRowEl.style.display = 'none';
            }
        }

        totalEl.textContent = `LKR ${total.toLocaleString()}`;
    }

    handlePayment() {
        if (this.cart.items.length === 0) {
            alert('Your cart is empty!');
            return;
        }
        alert(`Payment of LKR ${this.cart.getTotalWithDelivery().toLocaleString()} processed successfully!`);
        this.cart.items = [];
        this.cart.saveCart();
        this.cart.updateCartDisplay();
        this.closeCart();
    }
}

// Live Counter
class LiveCounter {
    constructor() {
        this.loggedInUsers = 240;
        this.onlineUsers = 0;
        this.maxOnline = 300;
        this.init();
    }

    init() {
        this.onlineUsers = Math.floor(Math.random() * 100) + 50;
        this.updateDisplay();
        this.startSimulation();
    }

    startSimulation() {
        setInterval(() => {
            const onlineChange = Math.floor(Math.random() * 8) - 3;
            this.onlineUsers = Math.max(this.loggedInUsers, Math.min(this.maxOnline, this.onlineUsers + onlineChange));
            this.updateDisplay();
        }, 3000);
    }

    updateDisplay() {
        const onlineElement = document.getElementById('onlineCount');
        if (onlineElement) {
            onlineElement.textContent = this.onlineUsers;
            onlineElement.style.animation = 'none';
            setTimeout(() => {
                onlineElement.style.animation = 'countUp 0.5s ease-out';
            }, 10);
        }
    }
}

// Spin to Win
class SpinToWin {
    constructor() {
        this.segments = [
            { label: '10% OFF', color: '#f9a8b8' },
            { label: '25% OFF', color: '#f43f5e' },
            { label: '20% OFF', color: '#f9a8b8' },
            { label: '10% OFF', color: '#f43f5e' },
            { label: '30% OFF', color: '#f9a8b8' },
            { label: '15% OFF', color: '#f43f5e' },
            { label: '10% OFF', color: '#f9a8b8' },
            { label: '20% OFF', color: '#f43f5e' },
        ];
        this.codes = {
            '10% OFF': 'MRS10', '15% OFF': 'MRS15',
            '20% OFF': 'MRS20', '25% OFF': 'MRS25', '30% OFF': 'MRS30'
        };
        this.currentAngle = 0;
        this.spinning = false;
        this.canvas = document.getElementById('spinWheelCanvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.drawWheel(0);
        this.attachEvents();
    }

    drawWheel(angle) {
        const ctx = this.ctx, cx = 120, cy = 120, r = 114;
        const arc = (2 * Math.PI) / this.segments.length;
        ctx.clearRect(0, 0, 240, 240);
        this.segments.forEach((seg, i) => {
            const start = angle + i * arc, end = start + arc;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, r, start, end);
            ctx.closePath();
            ctx.fillStyle = seg.color;
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(start + arc / 2);
            ctx.textAlign = 'right';
            ctx.fillStyle = '#fff';
            ctx.font = 'bold 11px sans-serif';
            ctx.fillText(seg.label, r - 10, 4);
            ctx.restore();
        });
        ctx.beginPath();
        ctx.arc(cx, cy, 18, 0, 2 * Math.PI);
        ctx.fillStyle = '#fff';
        ctx.fill();
        ctx.strokeStyle = '#ccc';
        ctx.lineWidth = 2;
        ctx.stroke();
    }

    spinWheel(targetIdx) {
        if (this.spinning) return;
        this.spinning = true;
        const arc = (2 * Math.PI) / this.segments.length;
        const extra = 5 * 2 * Math.PI;
        const targetAngle = extra + (2 * Math.PI - (targetIdx * arc + arc / 2));
        const duration = 4000, start = performance.now(), startAngle = this.currentAngle;
        const animate = (now) => {
            const t = Math.min((now - start) / duration, 1);
            const ease = 1 - Math.pow(1 - t, 4);
            this.currentAngle = startAngle + targetAngle * ease;
            this.drawWheel(this.currentAngle);
            if (t < 1) { requestAnimationFrame(animate); return; }
            this.currentAngle = this.currentAngle % (2 * Math.PI);
            this.spinning = false;
            const won = this.segments[targetIdx].label;
            document.getElementById('spinWonLabel').textContent = `You won ${won}!`;
            document.getElementById('spinCodeDisplay').textContent = this.codes[won] || 'MRSFASHION';
            document.getElementById('spinFormSection').style.display = 'none';
            document.getElementById('spinResultSection').classList.add('show');
        };
        requestAnimationFrame(animate);
    }

    tryLuck() {
        const email = document.getElementById('spinEmail').value.trim();
        const emailEl = document.getElementById('spinEmail');
        if (!email || !email.includes('@')) {
            emailEl.classList.add('has-error');
            emailEl.focus();
            return;
        }
        emailEl.classList.remove('has-error');
        this.spinWheel(Math.floor(Math.random() * this.segments.length));
    }

    open() {
        document.getElementById('spinModal').classList.add('open');
        document.getElementById('spinFormSection').style.display = 'block';
        document.getElementById('spinResultSection').classList.remove('show');
        document.getElementById('spinEmail').value = '';
        document.getElementById('spinName').value = '';
    }

    close() { document.getElementById('spinModal').classList.remove('open'); }

    attachEvents() {
        document.querySelector('.spin-now')?.addEventListener('click', (e) => { e.preventDefault(); this.open(); });
        document.getElementById('spinModalClose')?.addEventListener('click', () => this.close());
        document.getElementById('spinSkip')?.addEventListener('click', () => this.close());
        document.getElementById('spinTryBtn')?.addEventListener('click', () => this.tryLuck());
        document.getElementById('wheelCenterBtn')?.addEventListener('click', () => this.tryLuck());
        document.getElementById('spinDoneBtn')?.addEventListener('click', () => this.close());
        document.getElementById('spinModal')?.addEventListener('click', (e) => {
            if (e.target.id === 'spinModal') this.close();
        });
    }
}

