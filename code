        function refreshPayState(total) {
            const payBtn = $('scrPayBtn');
            const wallet = window.mrsFashionWallet;
            if (method === 'wallet') {
                const bal = wallet ? wallet.getBalance() : 0;
                $('scrWalletBalance').textContent = lkr(bal);
                const short = bal < total;
                $('scrPayMsg').textContent = short ? 'Insufficient E-Wallet balance. Top up your wallet or pay by card.' : '';
                $('scrPayMsg').className = 'scr-pay-msg' + (short ? ' err' : '');
                payBtn.disabled = short;
            } else {
                payBtn.disabled = false;
            }
        }

        const cardName = $('scrCardName'), cardNum = $('scrCardNumber'), cardExp = $('scrCardExpiry'), cardCvv = $('scrCardCvv');
        cardNum.addEventListener('input', () => {
            cardNum.value = cardNum.value.replace(/\D/g, '').slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1 ');
            cardNum.classList.remove('has-error');
        });
        cardExp.addEventListener('input', () => {
            const d = cardExp.value.replace(/\D/g, '').slice(0, 4);
            cardExp.value = d.length > 2 ? `${d.slice(0, 2)} / ${d.slice(2)}` : d;
            cardExp.classList.remove('has-error');
        });
        cardCvv.addEventListener('input', () => { cardCvv.value = cardCvv.value.replace(/\D/g, '').slice(0, 4); cardCvv.classList.remove('has-error'); });
        cardName.addEventListener('input', () => cardName.classList.remove('has-error'));

        function validCard() {
            const m = cardExp.value.match(/^(\d{2})\s*\/\s*(\d{2})$/);
            const checks = [
                [cardName, cardName.value.trim().length > 1],
                [cardNum, cardNum.value.replace(/\D/g, '').length >= 13],
                [cardExp, !!m && +m[1] >= 1 && +m[1] <= 12],
                [cardCvv, cardCvv.value.length >= 3],
            ];
            let first = null;
            checks.forEach(([el, ok]) => { el.classList.toggle('has-error', !ok); if (!ok && !first) first = el; });
            if (first) { first.focus(); return false; }
            return true;
        }

        $('scrPayBtn').addEventListener('click', () => {
            const loan = currentLoan();
            if (!loan || loan.paidCount >= loan.months) return;
            const ahead = parseInt($('scrAheadCount').value, 10) || 2;
            const q = getQuote(loan, option, ahead);
            if (q.total <= 0) return;

            let methodLabel;
            if (method === 'card') {
                if (!validCard()) return;
                methodLabel = 'Card ••••' + cardNum.value.replace(/\D/g, '').slice(-4);
            } else {
                const wallet = window.mrsFashionWallet;
                if (!wallet || wallet.getBalance() < q.total) { refreshPayState(q.total); return; }
                methodLabel = 'E-Wallet';
            }

            const btn = $('scrPayBtn');
            btn.disabled = true;
            btn.textContent = 'Processing…';

            setTimeout(() => {
                const receipt = 'RP' + Math.floor(10000 + Math.random() * 89999);
                if (method === 'wallet') window.mrsFashionWallet.setBalance(window.mrsFashionWallet.getBalance() - q.total);

                const fresh = currentLoan();
                fresh.paidCount = option === 'settle' ? fresh.months : Math.min(fresh.months, fresh.paidCount + q.count);
                if (fresh.paidCount >= fresh.months) fresh.settled = true;
                fresh.payments = fresh.payments || [];
                fresh.payments.push({
                    receipt, date: new Date().toISOString(), amount: q.total, lateFee: q.lateFee,
                    installments: q.count, type: option, method: methodLabel,
                });
                updateLoan(fresh);

                showReceipt(fresh, q, receipt, methodLabel);
                ['scrCardName', 'scrCardNumber', 'scrCardExpiry', 'scrCardCvv'].forEach(id => { $(id).value = ''; });
            }, 1100);
        });

        function showReceipt(loan, q, receipt, methodLabel) {
            const paidOff = loan.paidCount >= loan.months;
            const rows = buildSchedule(loan);
            const next = paidOff ? null : rows[loan.paidCount];

            $('scrDoneTitle').textContent = paidOff ? 'Loan fully repaid' : 'Payment received';
            $('scrDoneRef').textContent = 'Receipt #' + receipt;
            $('scrReceipt').innerHTML = `
                <div><span>Loan</span><strong>#${esc(loan.reference)}</strong></div>
                <div><span>Paid</span><strong>${q.label}</strong></div>
                ${q.lateFee ? `<div><span>Late charges</span><strong>${lkr(q.lateFee)}</strong></div>` : ''}
                <div><span>Method</span><strong>${esc(methodLabel)}</strong></div>
                <div class="scr-receipt-total"><span>Amount paid</span><strong>${lkr(q.total)}</strong></div>
                <div><span>Balance remaining</span><strong>${lkr((loan.months - loan.paidCount) * loan.monthly)}</strong></div>`;
            $('scrDoneText').textContent = paidOff
                ? 'Thank you! Your store credit has been repaid in full. A confirmation will be sent to you.'
                : `Thank you! Your next installment of ${lkr(loan.monthly)} is due on ${fmtDate(next.due)}.`;
            showView('scrViewDone');
        }

        $('scrDoneBack').addEventListener('click', () => { renderLoan(); showView('scrViewLoan'); });
        $('scrDoneClose').addEventListener('click', () => closeOverlay(repay));
    });
})();

