/* Ticket Booking */
.ticket-booking-btn {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border: none;
    border-radius: 50px;
    background: #ffffff;
    background-size: 200% 200%;
    background-position: 0% 50%;
    color: #000;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(26, 26, 26, 0.3);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.35s ease,
                background-position 0.6s ease;
    overflow: hidden;
    isolation: isolate;
}

.ticket-booking-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -60%;
    width: 45%;
    height: 100%;
    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg);
    z-index: 1;
    pointer-events: none;
    transition: left 0.05s linear;
}

.ticket-booking-btn::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50px;
    border: 2px solid var(--accent-color, #f43f5e);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
}

.ticket-booking-btn span,
.ticket-booking-btn i,
.ticket-booking-btn .ticket-icon-gif {
    position: relative;
    z-index: 2;
}

.ticket-booking-btn i {
    color: var(--accent-color, #f43f5e);
    font-size: 15px;
}

.ticket-booking-btn:hover {
    transform: translateY(-5px) scale(1.06);
    box-shadow: 0 20px 44px rgba(162, 154, 154, 0.42), 0 0 0 6px rgba(5, 5, 5, 0.12);
    background-position: 100% 50%;
    animation: ticketBtnWobble 0.6s ease;
}

.ticket-booking-btn:hover::before {
    animation: ticketBtnShine 1.1s ease-in-out infinite;
}

.ticket-booking-btn:hover::after {
    animation: ticketBtnPulseRing 1.4s ease-out infinite;
}

.ticket-booking-btn:hover .ticket-icon-gif {
    animation: ticketIconPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ticket-booking-btn:active {
    transform: translateY(-2px) scale(0.97);
}

@keyframes ticketBtnShine {
    0%   { left: -60%; }
    100% { left: 130%; }
}

@keyframes ticketBtnPulseRing {
    0%   { opacity: 0.55; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.18); }
}

@keyframes ticketBtnWobble {
    0%   { transform: translateY(0) scale(1) rotate(0deg); }
    30%  { transform: translateY(-7px) scale(1.08) rotate(-2deg); }
    55%  { transform: translateY(-3px) scale(1.05) rotate(1.5deg); }
    75%  { transform: translateY(-6px) scale(1.07) rotate(-0.5deg); }
    100% { transform: translateY(-5px) scale(1.06) rotate(0deg); }
}

@keyframes ticketIconPop {
    0%   { transform: scale(1) rotate(0deg); }
    40%  { transform: scale(1.35) rotate(-14deg); }
    70%  { transform: scale(0.95) rotate(8deg); }
    100% { transform: scale(1.1) rotate(0deg); }
}

.ticket-modal {
    position: fixed;
    inset: 0;
    z-index: 40800;
    background: rgba(15, 23, 42, 0.75);
