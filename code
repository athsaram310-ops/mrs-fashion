    background: #fdeef1;
}

.checkout-shipping-option-left { display: flex; align-items: center; gap: 10px; }

.checkout-shipping-option input { accent-color: var(--accent-color, #f43f5e); width: 16px; height: 16px; }

.checkout-shipping-option-name { font-weight: 600; color: var(--text-dark, #1e293b); }

.checkout-shipping-option-eta { font-size: 12px; color: var(--text-light, #64748b); }

.checkout-shipping-option-price { font-weight: 700; color: var(--text-dark, #1e293b); }

.checkout-pay-note {
    font-size: 12.5px;
    color: var(--text-light, #64748b);
    margin-bottom: 14px;
}

.checkout-pay-list {
    border: 1.5px solid #e2e2e2;
    border-radius: 8px;
    overflow: hidden;
}

.checkout-pay-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 16px;
    border-top: 1.5px solid #e2e2e2;
    cursor: pointer;
    background: var(--white, #fff);
    transition: background 0.2s ease;
}

.checkout-pay-option:first-child { border-top: none; }

.checkout-pay-option.selected {
    position: relative;
    z-index: 1;
    background: #fdeef1;
    box-shadow: inset 0 0 0 1.5px var(--accent-color, #f43f5e);
}

.checkout-pay-option-left {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark, #1e293b);
}

.checkout-pay-option input { width: 17px; height: 17px; accent-color: var(--accent-color, #f43f5e); cursor: pointer; }

.checkout-pay-icons { display: flex; align-items: center; gap: 6px; font-size: 20px; color: var(--text-light, #64748b); }

.checkout-pay-detail {
    display: none;
    margin: 0 16px 16px;
    padding: 14px 16px;
    border-radius: 8px;
    text-align: center;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-light, #64748b);
    background: #f5f5f5;
}

.checkout-pay-option.selected + .checkout-pay-detail { display: block; }

.checkout-card-details {
    display: none;
    flex-direction: column;
    gap: 10px;
    margin: -6px 16px 16px;
    padding: 14px 16px 4px;
    border-radius: 8px;
    background: #f9f9fb;
    border: 1.5px solid #e2e2e2;
}

.checkout-card-details.show { display: flex; }

.checkout-card-details .checkout-row { gap: 12px; }

.checkout-pay-option.pay-option-hidden,
.checkout-pay-option.pay-option-hidden + .checkout-pay-detail {
    display: none !important;
}

.checkout-billing-list {
    border: 1.5px solid #e2e2e2;
    border-radius: 8px;
    overflow: hidden;
}

.checkout-billing-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 16px;
    border-top: 1.5px solid #e2e2e2;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark, #1e293b);
    transition: background 0.2s ease;
}

.checkout-billing-option:first-child { border-top: none; }

.checkout-billing-option.selected {
    position: relative;
    z-index: 1;
    background: #fdeef1;
    box-shadow: inset 0 0 0 1.5px var(--accent-color, #f43f5e);
}

.checkout-billing-option input { width: 17px; height: 17px; accent-color: var(--accent-color, #f43f5e); cursor: pointer; }

.checkout-pay-btn {
    width: 100%;
    padding: clamp(13px, 2vw, 17px);
    margin-top: clamp(18px, 3vw, 30px);
    border: none;
    border-radius: 50px;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    color: #fff;
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(26, 26, 26, 0.28);
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.2s ease;
}

.checkout-pay-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 38px rgba(26, 26, 26, 0.34);
}

.checkout-pay-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
}

.checkout-legal {
    display: flex;
    gap: 18px;
    justify-content: center;
    margin-top: 26px;
    font-size: 12px;
}

.checkout-legal a { color: var(--text-light, #64748b); text-decoration: underline; }

.checkout-summary-col {
    position: relative;
    min-height: 0;
    background: linear-gradient(165deg, #fff8f6 0%, #fdeef1 55%, #fce3ea 100%);
    border-left: 1px solid rgba(26, 26, 26, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.checkout-summary-col::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background:
        radial-gradient(circle at center, rgba(26,26,26,0.10) 2.5px, transparent 2.6px) repeat-y;
    background-size: 100% 16px;
}

.checkout-summary-scroll {
    flex: 1;
    overflow-y: auto;
    padding: clamp(24px, 4vw, 44px) clamp(24px, 4vw, 44px) 20px;
}

.checkout-summary-item {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: clamp(14px, 2.5vw, 22px);
}

.checkout-summary-thumb {
    position: relative;
    width: clamp(50px, 6vw, 62px);
    height: clamp(50px, 6vw, 62px);
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(135deg, #f0e3e6, #e8d5da);
    box-shadow: 0 4px 14px rgba(26, 26, 26, 0.12);
}

.checkout-summary-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

.checkout-summary-qty {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary-color, #1a1a1a);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.checkout-summary-info { flex: 1; min-width: 0; }

.checkout-summary-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dark, #1e293b);
    line-height: 1.4;
}

.checkout-summary-variant { font-size: 12px; color: var(--text-light, #64748b); }

.checkout-summary-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dark, #1e293b);
    white-space: nowrap;
}

.checkout-summary-empty {
    text-align: center;
    padding: 40px 10px;
    color: var(--text-light, #64748b);
    font-size: 14px;
}

.checkout-discount-row {
    display: flex;
    gap: 10px;
    margin: 8px 0 clamp(16px, 3vw, 26px);
}

.checkout-discount-row input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: 1.5px solid rgba(26, 26, 26, 0.15);
    border-radius: 8px;
    font-size: 13.5px;
    font-family: inherit;
    background: #fff;
}

.checkout-discount-row input:focus { outline: none; border-color: var(--primary-color, #1a1a1a); }

.checkout-discount-row button {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    background: var(--primary-color, #1a1a1a);
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.25s ease;
}

.checkout-discount-row button:hover { background: var(--accent-color, #f43f5e); }

.checkout-discount-msg {
    font-size: 12px;
    margin: -18px 0 20px;
    min-height: 15px;
}

.checkout-discount-msg.ok { color: #16a34a; }

.checkout-discount-msg.err { color: var(--accent-color, #f43f5e); }

.checkout-summary-totals {
    position: relative;
    flex-shrink: 0;
    padding: clamp(18px, 3vw, 26px) clamp(24px, 4vw, 44px) clamp(26px, 4vw, 40px);
    border-top: 1.5px dashed rgba(26, 26, 26, 0.14);
}

.checkout-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--text-dark, #1e293b);
    margin-bottom: clamp(8px, 1.5vw, 12px);
}

.checkout-total-row span:last-child { font-weight: 600; }

.checkout-total-row.discount span:last-child { color: var(--accent-color, #f43f5e); }

.checkout-total-row.grand {
    margin-top: clamp(10px, 2vw, 16px);
    padding-top: clamp(10px, 2vw, 16px);
    border-top: 1px solid rgba(26, 26, 26, 0.1);
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 800;
}

.checkout-total-currency-note {
    font-size: 11px;
    color: var(--text-light, #64748b);
    text-align: right;
    margin-top: -8px;
    margin-bottom: 4px;
}

.checkout-confirm {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    padding: clamp(24px, 5vw, 40px);
    overflow-y: auto;
}

.checkout-confirm.show { display: flex; }

.checkout-confirm-icon {
    width: clamp(56px, 8vw, 76px);
    height: clamp(56px, 8vw, 76px);
    border-radius: 50%;
    background: #fdeef1;
    color: var(--accent-color, #f43f5e);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(24px, 4vw, 32px);
    margin-bottom: clamp(14px, 3vw, 22px);
