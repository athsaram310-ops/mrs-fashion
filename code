.page-btn {
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 10px;
    border: 2px solid transparent;
    background: var(--white, #fff);
    color: var(--primary-color, #1a1a1a);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
