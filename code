    function renderJewelryStars(rating) {
        const full = Math.floor(rating);
        const hasHalf = rating - full >= 0.5;
        let html = '';
        for (let s = 0; s < full; s++) html += '<i class="fas fa-star"></i>';
        if (hasHalf) html += '<i class="fas fa-star-half-alt"></i>';
        const remaining = 5 - full - (hasHalf ? 1 : 0);
        for (let s = 0; s < remaining; s++) html += '<i class="far fa-star"></i>';
        return html;
    }

