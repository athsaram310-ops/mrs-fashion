(function () {
    var VIDEO_SRC = 'web photo/Pink_and_white_fabric_billowing_20260919175355.mp4';

    function setupLoginVideo(modal) {
        if (modal.querySelector('.login-bg-video')) return;

        var video = document.createElement('video');
        video.className = 'login-bg-video';
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('disablePictureInPicture', '');
        video.setAttribute('aria-hidden', 'true');

        var src = document.createElement('source');
        src.src = VIDEO_SRC;
        src.type = 'video/mp4';
        video.appendChild(src);

        var shade = document.createElement('div');
        shade.className = 'login-bg-shade';

        modal.insertBefore(shade, modal.firstChild);
        modal.insertBefore(video, modal.firstChild);

        function sync() {
            if (modal.classList.contains('active')) {
                video.muted = true;
                var p = video.play();
                if (p && p.catch) p.catch(function () {});
            } else {
                video.pause();
            }
        }
        new MutationObserver(sync).observe(modal, { attributes: true, attributeFilter: ['class'] });
        sync();
    }

    function findModal() {
        var modal = document.querySelector('.login-modal');
        if (modal) setupLoginVideo(modal);
        return !!modal;
    }

    if (!findModal()) {
        var watcher = new MutationObserver(function () {
            if (findModal()) watcher.disconnect();
        });
        watcher.observe(document.documentElement, { childList: true, subtree: true });
    }
})();

