function getSizeOptions(categoryKey, productId) {
    const hasOverride = Object.prototype.hasOwnProperty.call(SIZE_OVERRIDES, productId);
    const presetKey = hasOverride ? SIZE_OVERRIDES[productId] : SIZE_CATEGORY_DEFAULTS[categoryKey];
    return presetKey && SIZE_PRESETS[presetKey] ? SIZE_PRESETS[presetKey] : null;
}

function productSizesHTML(product) {
    if (!product || !product.sizeOptions || !product.sizeOptions.length) return '';
    return `
        <div class="product-sizes-wrap">
            <div class="product-sizes" role="group" aria-label="Select size">
                ${product.sizeOptions.map(size => `
                    <button
                        type="button"
                        class="size-option"
                        data-size="${size}"
                        aria-pressed="false"
                        onclick="selectProductSize(this)"
                    >${size}</button>
                `).join('')}
            </div>
            <p class="product-sizes-error" role="alert">Please select a size</p>
        </div>
    `;
}

function selectProductSize(sizeBtn) {
    const card = sizeBtn.closest('.product-card');
    if (!card) return;
    card.querySelectorAll('.size-option').forEach(b => {
        const isThis = b === sizeBtn;
        b.classList.toggle('active', isThis);
        b.setAttribute('aria-pressed', isThis ? 'true' : 'false');
    });
    card.dataset.selectedSize = sizeBtn.getAttribute('data-size') || '';
    const wrap = card.querySelector('.product-sizes-wrap');
    if (wrap) wrap.classList.remove('needs-size');
}

function getSelectedSizeForCard(card) {
    if (!card) return null;
    return card.dataset.selectedSize || null;
}

function flagSizeRequired(card) {
    const wrap = card ? card.querySelector('.product-sizes-wrap') : null;
    if (!wrap) return;
    wrap.classList.remove('needs-size');
    void wrap.offsetWidth;
    wrap.classList.add('needs-size');
}

function resolveSizeForCard(card, product) {
    if (!product || !product.sizeOptions || !product.sizeOptions.length) {
        return { ok: true, size: null };
    }
    const size = getSelectedSizeForCard(card);
    if (!size) {
        flagSizeRequired(card);
        return { ok: false, size: null };
    }
    return { ok: true, size };
}

// Shopping Cart
class ShoppingCart {
    constructor() {
        this.items = [];
        this.deliveryFee = 500;
        this.loadCart();
    }

    normalizeId(value) {
        return String(value ?? '');
    }

    normalizeColor(value) {
        return value === null || value === undefined || value === '' ? null : String(value);
    }

    normalizeSize(value) {
        return value === null || value === undefined || value === '' ? null : String(value);
    }

    isSameLine(item, productId, color, size) {
        return this.normalizeId(item.id) === this.normalizeId(productId)
            && this.normalizeColor(item.color) === this.normalizeColor(color)
            && this.normalizeSize(item.size) === this.normalizeSize(size);
    }

    addItem(product) {
        const color = this.normalizeColor(product.color);
        const size = this.normalizeSize(product.size);
        const existingItem = this.items.find(item => this.isSameLine(item, product.id, color, size));

        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            this.items.push({ ...product, quantity: 1, color: color, size: size });
        }

        this.saveCart();
        this.updateCartDisplay();
        this.showNotification(`${product.name}${size ? ` (${size})` : ''} added to cart!`);
    }

    removeItem(productId, color = null, size = null) {
        this.items = this.items.filter(item => !this.isSameLine(item, productId, color, size));
        this.saveCart();
        this.updateCartDisplay();
    }

    increaseQuantity(productId, color = null, size = null) {
        const item = this.items.find(i => this.isSameLine(i, productId, color, size));
        if (!item) return;
        item.quantity += 1;
        this.saveCart();
        this.updateCartDisplay();
    }

    decreaseQuantity(productId, color = null, size = null) {
        const item = this.items.find(i => this.isSameLine(i, productId, color, size));
        if (!item) return;
        item.quantity -= 1;
        if (item.quantity <= 0) {
            this.removeItem(productId, color, size);
            return;
        }
        this.saveCart();
        this.updateCartDisplay();
    }

    updateCartDisplay() {
        const totalItems = this.items.reduce((sum, item) => sum + item.quantity, 0);
        document.querySelectorAll('.cart-count').forEach(cartCount => {
            cartCount.textContent = totalItems;
            cartCount.style.animation = 'none';
            void cartCount.offsetWidth;
            cartCount.style.animation = 'scaleIn 0.3s ease-out';
        });
    }

    getTotalPrice() {
        return this.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    }

    hasEvoucher() {
        return this.items.some(item => item.isEvoucher);
    }

    getDiscountPercentage() {
        const subtotal = this.getTotalPrice();
        let pct = 0;
        if (subtotal >= 10000) pct = 20;
        else if (subtotal >= 5000) pct = 10;
        if (subtotal > 0 && this.hasEvoucher()) pct += 5;
        return pct;
    }

    getDiscountAmount() {
        return Math.round(this.getTotalPrice() * (this.getDiscountPercentage() / 100));
    }

    isTicketsOnly() {
    return this.items.length > 0 && this.items.every(item => item.isTicket);
    }

    getDeliveryFee() {
    return this.isTicketsOnly() ? 0 : this.deliveryFee;
    }

    getTotalWithDelivery() {
    return this.getTotalPrice() - this.getDiscountAmount() + this.getDeliveryFee();
    }

    saveCart() {
        localStorage.setItem('cart', JSON.stringify(this.items));
    }

    loadCart() {
        const saved = localStorage.getItem('cart');
        if (saved) {
            this.items = JSON.parse(saved);
            this.updateCartDisplay();
        }
    }

    showNotification(message) {
        const notification = document.createElement('div');
        notification.className = 'cart-notification';
        notification.textContent = message;
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('is-leaving');
            setTimeout(() => notification.remove(), 400);
        }, 2000);
    }
}

// Cart Modal
function escapeCartText(value) {
    return String(value ?? '').replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch]));
}

function cartItemRowHTML(item) {
    const lineAttrs = `data-id="${escapeCartText(item.id)}" data-color="${escapeCartText(item.color || '')}" data-size="${escapeCartText(item.size || '')}"`;
    const priceHTML = item.isPending
        ? `<div class="cart-item-price is-pending">Quote pending</div>`
        : `<div class="cart-item-price">LKR ${(item.price * item.quantity).toLocaleString()}</div>`;
    return `
        <div class="cart-item${item.isPending ? ' is-pending' : ''}">
            <div class="cart-item-details">
                ${item.isVIP ? `<span class="vip-badge">VIP${item.categoryLabel ? ' — ' + escapeCartText(item.categoryLabel) : ''}</span>` : ''}
                ${item.isPending ? `<span class="pending-badge"><i class="fas fa-hourglass-half"></i> Pending</span>` : ''}
                ${item.color ? `
