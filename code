            { tag: 'AquaGlide Kickboard',                keyword: 'kickboard',     base: 1900 },
            { tag: 'Labubu Print Ceramic Mug',           keyword: 'mug',           base: 2000 },
            { tag: 'Starlight Chunky Bangle Set',        keyword: 'jewelry',       base: 1600 },
            { tag: 'Blush Bloom Gift Box',               keyword: 'gift box',      base: 2200 },
            { tag: 'Forever Wishes Greeting Card',       keyword: 'greeting card', base: 350 },
            { tag: 'Kraft Ribbon Gift Wrap Set',         keyword: 'gift wrap',     base: 900 },
            { tag: 'Petal Print Gift Bag',               keyword: 'gift bag',      base: 650 },
            { tag: 'Wildflower Floral Notebook',         keyword: 'notebook',      base: 700 },
            { tag: 'Araliya Bloom Scented Candle',       keyword: 'candle',        base: 1800 },
            { tag: 'Botanical Print Tote Bag',           keyword: 'tote bag',      base: 2600 },
            { tag: 'Sparkle Trail Glitter Pen Set',      keyword: 'pen set',       base: 950 },
        ];
        const adjectives = ['','','','','','','','','',''];
        const badgeCycle = [null, 'hot', 'sale', null, 'Trendy', null, 'hot', 'sale', null, 'Trendy', null,'hot', 'sale', null, 'Trendy', null, 'hot', 'sale', 'Trendy'];
        const totalItems = 40;

        const products = [];
        for (let i = 0; i < totalItems; i++) {
            const cat = categories[i % categories.length];
            const adj = adjectives[i % adjectives.length];
            const price = cat.base + ((i * 137) % 1800);
            const originalPrice = Math.round(price * (1.25 + ((i % 4) * 0.08)));
            const rating = 3.5 + ((i % 4) * 0.5);
            const badgeRaw = badgeCycle[i % badgeCycle.length];
            const id = i + 1;

            products.push({
                id,
                name: `${adj} ${cat.tag}`,
                category: cat.tag,
                price,
                originalPrice,
                rating,
                badge: badgeRaw,
                colorOptions: PRODUCT_COLOR_OPTIONS[id] || null,
                image: `Product Images/product/product-${id}.png`,
                fallback: 'Product Images/product/product-1.png'
            });
