        }

        $('scrOptions').addEventListener('click', (e) => {
            const opt = e.target.closest('.scr-option');
            if (!opt || e.target.closest('select')) return;
            option = opt.dataset.option;
            renderQuote();
        });
        $('scrAheadCount').addEventListener('change', () => { option = 'ahead'; renderQuote(); });
        $('scrAheadCount').addEventListener('click', (e) => e.stopPropagation());

        $('scrMethod').addEventListener('click', (e) => {
            const btn = e.target.closest('.scr-method-btn');
            if (!btn) return;
            method = btn.dataset.method;
            repay.querySelectorAll('.scr-method-btn').forEach(b => b.classList.toggle('active', b === btn));
            $('scrCardFields').style.display = method === 'card' ? '' : 'none';
