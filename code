        let html = '';
        for (let s = 0; s < full; s++) html += '<i class="fas fa-star"></i>';
        if (hasHalf) html += '<i class="fas fa-star-half-alt"></i>';
        const remaining = 5 - full - (hasHalf ? 1 : 0);
        for (let s = 0; s < remaining; s++) html += '<i class="far fa-star"></i>';
        return html;
    }

    function colorSwatchesHTML(product) {
        if (!product.colorOptions || !product.colorOptions.length) return '';
        return `
            <div class="product-colors">
                ${product.colorOptions.map((opt, idx) => `
                    <button
                        type="button"
                        class="color-swatch${idx === 0 ? ' active' : ''}"
                        style="background-color:${opt.color}"
                        data-color="${opt.color}"
                        aria-label="View in ${opt.color}"
                        onclick="swapProductImage(this, '${opt.image}')"
                    ></button>
                `).join('')}
            </div>
        `;
    }

    function footwearCardHTML(product, indexOnPage) {
        const badgeHTML = product.badge
            ? `<div class="product-badge${product.badge === 'hot' ? ' hot' : ''}${product.badge === 'sale' ? ' sale' : ''}">${product.badge === 'hot' ? 'Hot' : product.badge === 'sale' ? 'Sale' : product.badge}</div>`
            : '';
        return `
            <div class="product-card" data-id="${product.id}" style="animation-delay:${0.05 * indexOnPage}s">
                <div class="product-image">
                    <img src="${product.img}" alt="${product.name}" loading="lazy"
                         data-fallback="${product.fallback}"
                         onerror="if(this.src !== this.dataset.fallback){ this.src = this.dataset.fallback; }">
                    ${badgeHTML}
                </div>
                <div class="product-info">
                    <h3>${product.name}</h3>
                    <div class="product-rating">${renderStars(product.rating)}</div>
                    <div class="product-price">
                        <span class="price">LKR ${product.price.toLocaleString()}</span>
                        <span class="original-price">LKR ${product.originalPrice.toLocaleString()}</span>
                    </div>
                    ${colorSwatchesHTML(product)}
                    ${productSizesHTML(product)}
                    <button class="btn btn-outline btn-full footwear-add-btn" data-id="${product.id}">Add to Cart</button>
                </div>
            </div>
        `;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const exploreBtn = document.getElementById('exploreFootwearBtn');
        const overlay = document.getElementById('footwearModal');
        if (!exploreBtn || !overlay) return;

        const closeBtn = document.getElementById('footwearModalClose');
        const viewCategories = document.getElementById('footwearViewCategories');
        const viewItems = document.getElementById('footwearViewItems');
        const backBtn = document.getElementById('footwearBackBtn');
        const categoryTiles = overlay.querySelectorAll('.footwear-category-tile');

        const itemsIcon = document.getElementById('footwearItemsIcon');
        const itemsTitle = document.getElementById('footwearItemsTitle');
        const itemsSub = document.getElementById('footwearItemsSub');
        const itemsGrid = document.getElementById('footwearItemsGrid');

        function showCategories() {
            viewItems.classList.remove('show');
            viewCategories.classList.add('show');
        }

        function showItems(categoryKey) {
            const meta = FOOTWEAR_META[categoryKey];
            if (!meta) return;

            itemsIcon.className = 'fas ' + meta.icon;
            itemsTitle.textContent = meta.title;
            itemsSub.textContent = meta.subtitle;
            itemsGrid.innerHTML = meta.products.map((p, i) => footwearCardHTML(p, i)).join('');

            viewCategories.classList.remove('show');
            viewItems.classList.add('show');
        }

        categoryTiles.forEach(tile => {
            tile.addEventListener('click', () => {
                showItems(tile.getAttribute('data-footwear-category'));
            });
        });

        backBtn.addEventListener('click', showCategories);

        itemsGrid.addEventListener('click', (e) => {
            const btn = e.target.closest('.footwear-add-btn');
            if (!btn) return;
            e.preventDefault();
            const id = parseInt(btn.getAttribute('data-id'), 10);
            const allFootwear = [...MENS_FOOTWEAR, ...WOMENS_FOOTWEAR];
            const product = allFootwear.find(p => p.id === id);
            if (product && window.mrsFashionCart) {
                const card = btn.closest('.product-card');
                const sizeChoice = resolveSizeForCard(card, product);
                if (!sizeChoice.ok) return;
                const selectedColor = product.colorOptions ? getSelectedColorForCard(card) : null;
                const selectedImage = selectedColor ? getSelectedImageForCard(card) : null;
                const cartProduct = selectedColor
                    ? { ...product, color: selectedColor, image: selectedImage || product.img }
                    : { ...product, image: product.img };
                if (sizeChoice.size) cartProduct.size = sizeChoice.size;
                window.mrsFashionCart.addItem(cartProduct);
            }
        });

        function openModal() {
            overlay.classList.add('open');
            document.documentElement.style.overflow = 'hidden';
            showCategories();
        }

        function closeModal() {
            overlay.classList.remove('open');
            document.documentElement.style.overflow = '';
        }

        exploreBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
        });
    });
})();

