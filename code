/* Checkout */
.checkout-overlay {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    z-index: 45000;
    background: var(--white, #fff);
    display: none;
    flex-direction: column;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text-dark, #1e293b);
}

.checkout-overlay.open {
    display: flex;
    animation: checkoutFadeIn 0.35s ease;
}

@keyframes checkoutFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.checkout-form-state {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.checkout-topbar {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(12px, 2vw, 18px) clamp(20px, 4vw, 40px);
    border-bottom: 1px solid #eee;
}

.checkout-logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.01em;
    background: var(--gradient, linear-gradient(135deg, #1a1a1a, #333333));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    cursor: default;
}

.checkout-topbar-right {
    display: flex;
    align-items: center;
    gap: 22px;
}

.checkout-cart-icon {
    position: relative;
    background: none;
    border: none;
    font: inherit;
    color: var(--text-dark, #1e293b);
    font-size: 18px;
    cursor: pointer;
    padding: 0;
}

.checkout-close {
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    color: var(--primary-color, #1a1a1a);
    cursor: pointer;
    transition: transform 0.3s ease;
}

.checkout-close:hover { transform: rotate(90deg); }

.checkout-body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(320px, 32vw, 460px);
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
    min-height: 0;
}

.checkout-form-col {
    min-height: 0;
    overflow-y: auto;
    padding: clamp(24px, 4vw, 44px) clamp(24px, 5vw, 64px) clamp(40px, 8vw, 90px);
}

.checkout-form-inner { max-width: min(520px, 100%); margin: 0 auto; }

.checkout-section { margin-bottom: clamp(22px, 3vw, 34px); }

.checkout-section-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dark, #1e293b);
    margin-bottom: clamp(10px, 2vw, 16px);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.checkout-section-title a {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--accent-color, #f43f5e);
    text-decoration: none;
}

.checkout-section-title a:hover { text-decoration: underline; }

.checkout-field {
    width: 100%;
    padding: clamp(10px, 1.6vw, 13px) 16px;
    border: 1.5px solid #e2e2e2;
    border-radius: 8px;
    font-size: 14px;
