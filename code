            if (activeMethod !== 'binance' && binanceIdField) binanceIdField.classList.remove('has-error');
            if (activeMethod !== 'bybit' && bybitIdField) bybitIdField.classList.remove('has-error');
            if (activeMethod !== 'paypal' && paypalEmailField) paypalEmailField.classList.remove('has-error');
            if (activeMethod !== 'ewallet' && ewalletMsgEl) ewalletMsgEl.textContent = '';

            refreshPayButtonState();
        }

        deliveryToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.checkout-toggle-btn');
            if (!btn) return;
            deliveryMode = btn.dataset.mode;
            deliveryToggle.querySelectorAll('.checkout-toggle-btn').forEach(b => b.classList.toggle('active', b === btn));

            const isPickup = deliveryMode === 'pickup';
            shipFields.style.display = isPickup ? 'none' : '';
            pickupNote.style.display = isPickup ? 'block' : 'none';
            shippingSection.style.display = isPickup ? 'none' : '';
